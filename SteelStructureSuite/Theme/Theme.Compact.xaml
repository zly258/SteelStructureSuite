<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
        紧凑密度整包入口（与默认 Theme.xaml 等价）。
        适合：工程插件工具条、属性面板、大表格工作台。
        用法与 Theme.xaml 相同，只替换 Source 文件名。
    -->
    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="Tokens.xaml" />
        <ResourceDictionary Source="Controls.xaml" />
        <ResourceDictionary Source="DataControls.xaml" />
        <ResourceDictionary Source="Icons.xaml" />
        <ResourceDictionary Source="Extras.xaml" />
        <!-- 密度档案必须最后合并，才能让密度键在查找时优先命中。 -->
        <ResourceDictionary Source="Density.Compact.xaml" />
    </ResourceDictionary.MergedDictionaries>

</ResourceDictionary>
