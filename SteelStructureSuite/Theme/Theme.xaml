<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
        唯一推荐入口（本产品默认密度 = 紧凑 Compact）。
        工程插件、截面库、材料统计与模型管理器以数据密度优先，
        因此默认采用紧凑档；需要中等 / 宽松时改用
        Theme.Medium.xaml / Theme.Relaxed.xaml。
        App.xaml:
            <ResourceDictionary>
                <ResourceDictionary.MergedDictionaries>
                    <ResourceDictionary Source="pack://application:,,,/YourAssembly;component/Theme/Theme.xaml"/>
                </ResourceDictionary.MergedDictionaries>
            </ResourceDictionary>

        Controls.xaml / DataControls.xaml / Icons.xaml / Extras.xaml 内部
        各自合并了 Tokens.xaml（颜色/字体兜底），这里显式再加一次
        Tokens.xaml 以保证「Tokens → Density → 控件」的覆盖顺序。
        换密度：把最后的 Source 换成 Density.Medium.xaml 或 Density.Relaxed.xaml。
    -->
    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="Tokens.xaml" />
        <ResourceDictionary Source="Controls.xaml" />
        <ResourceDictionary Source="DataControls.xaml" />
        <ResourceDictionary Source="Icons.xaml" />
        <ResourceDictionary Source="Extras.xaml" />
        <!-- 密度档案必须最后合并：控件字典内部又合并了 Tokens（中等兜底），
             只有最后合并才能让密度键在查找时优先命中。 -->
        <ResourceDictionary Source="Density.Compact.xaml" />
    </ResourceDictionary.MergedDictionaries>

</ResourceDictionary>
