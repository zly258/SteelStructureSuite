<Window x:Class="SteelStructureSuite.Views.AboutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="关于 参数化钢结构套件"
        Width="560" Height="560"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        UseLayoutRounding="True">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 标题区 -->
        <StackPanel Grid.Row="0" Orientation="Horizontal">
            <Border Width="56" Height="56"
                    Background="#0067C0"
                    CornerRadius="8"
                    VerticalAlignment="Top">
                <TextBlock Text="SS"
                           Foreground="White"
                           FontSize="22"
                           FontWeight="Bold"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center" />
            </Border>
            <StackPanel Margin="14,0,0,0" VerticalAlignment="Center">
                <TextBlock Text="参数化钢结构套件"
                           FontSize="20"
                           FontWeight="SemiBold" />
                <TextBlock Text="SteelStructureSuite for AutoCAD"
                           FontSize="12"
                           Foreground="#5F6368"
                           Margin="0,4,0,0" />
            </StackPanel>
        </StackPanel>

        <!-- 基本信息 -->
        <Grid Grid.Row="1" Margin="0,18,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="86" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Grid.Column="0" Text="版本" Foreground="#5F6368" Margin="0,0,0,6" />
            <TextBlock x:Name="TxtVersion" Grid.Row="0" Grid.Column="1" Text="-" Margin="0,0,0,6" />

            <TextBlock Grid.Row="1" Grid.Column="0" Text="适用平台" Foreground="#5F6368" Margin="0,0,0,6" />
            <TextBlock Grid.Row="1" Grid.Column="1" Text="AutoCAD 2019 ~ 2024（x64）" Margin="0,0,0,6" />

            <TextBlock Grid.Row="2" Grid.Column="0" Text="运行时" Foreground="#5F6368" Margin="0,0,0,6" />
            <TextBlock Grid.Row="2" Grid.Column="1" Text=".NET Framework 4.8" Margin="0,0,0,6" />

            <TextBlock Grid.Row="3" Grid.Column="0" Text="许可证" Foreground="#5F6368" Margin="0,0,0,6" />
            <TextBlock Grid.Row="3" Grid.Column="1" Text="MIT License" Margin="0,0,0,6" />

            <TextBlock Grid.Row="4" Grid.Column="0" Text="联系" Foreground="#5F6368" />
            <TextBlock Grid.Row="4" Grid.Column="1" Text="zhangly1403@qq.com" />
        </Grid>

        <!-- 许可证条款 -->
        <GroupBox Grid.Row="2" Header="MIT 许可证条款" Margin="0,16,0,0" Padding="8">
            <TextBox x:Name="TxtLicenseSummary"
                     IsReadOnly="True"
                     BorderThickness="0"
                     Background="Transparent"
                     TextWrapping="Wrap"
                     VerticalScrollBarVisibility="Auto"
                     FontSize="11.5"
                     Foreground="#3C4043" />
        </GroupBox>

        <!-- 按钮区 -->
        <Grid Grid.Row="3" Margin="0,14,0,0">
            <TextBlock x:Name="TxtCopyright"
                       VerticalAlignment="Center"
                       FontSize="11"
                       Foreground="#5F6368" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="完整许可证"
                        MinWidth="96"
                        Padding="12,5"
                        Margin="0,0,8,0"
                        Click="OnOpenLicenseClick" />
                <Button Content="关闭"
                        MinWidth="88"
                        Padding="12,5"
                        IsDefault="True"
                        IsCancel="True"
                        Click="OnCloseClick" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
