<Window x:Class="SteelStructureSuite.Views.AboutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="关于 参数化钢结构套件"
        Width="560"
        MinWidth="520"
        MinHeight="320"
        SizeToContent="Height"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResize"
        ShowInTaskbar="False"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/SteelStructureSuite;component/Views/Styles/DefaultMetrics.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" MaxHeight="480">
            <StackPanel>
                <StackPanel>
                    <TextBlock Text="参数化钢结构套件"
                               FontSize="15"
                               FontWeight="SemiBold" />
                    <TextBlock Text="SteelStructureSuite for AutoCAD"
                               Foreground="{x:Static SystemColors.GrayTextBrush}"
                               Margin="0,2,0,0" />
                </StackPanel>

                <Grid Margin="0,12,0,0" Grid.IsSharedSizeScope="True">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" MinWidth="80" SharedSizeGroup="AboutLabel" />
                        <ColumnDefinition Width="14" />
                        <ColumnDefinition Width="*" MinWidth="200" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Grid.Column="0" Text="版本" Margin="0,2" />
                    <TextBlock x:Name="TxtVersion" Grid.Row="0" Grid.Column="2" Text="-" Margin="0,2" />

                    <TextBlock Grid.Row="1" Grid.Column="0" Text="适用平台" Margin="0,2" />
                    <TextBlock Grid.Row="1" Grid.Column="2" Text="AutoCAD / Plant 3D 2019 ~ 2026（x64）" TextWrapping="Wrap" Margin="0,2" />

                    <TextBlock Grid.Row="2" Grid.Column="0" Text="运行时" Margin="0,2" />
                    <TextBlock Grid.Row="2" Grid.Column="2" Text=".NET Framework 4.8 / .NET 8.0" Margin="0,2" />

                    <TextBlock Grid.Row="3" Grid.Column="0" Text="许可证" Margin="0,2" />
                    <TextBlock Grid.Row="3" Grid.Column="2" Text="GNU GPL v3.0" Margin="0,2" />

                    <TextBlock Grid.Row="4" Grid.Column="0" Text="仓库地址" Margin="0,2" />
                    <TextBlock Grid.Row="4" Grid.Column="2" TextWrapping="Wrap" Margin="0,2">
                        <Hyperlink NavigateUri="https://github.com/zly258/SteelStructureSuite" RequestNavigate="OnRequestNavigate">https://github.com/zly258/SteelStructureSuite</Hyperlink>
                    </TextBlock>

                    <TextBlock Grid.Row="5" Grid.Column="0" Text="联系邮箱" Margin="0,2" />
                    <TextBlock Grid.Row="5" Grid.Column="2" Margin="0,2">
                        <Hyperlink NavigateUri="mailto:zhangly1403@qq.com" RequestNavigate="OnRequestNavigate">zhangly1403@qq.com</Hyperlink>
                    </TextBlock>

                    <TextBlock Grid.Row="6" Grid.Column="0" Text="赞助地址" Margin="0,2" />
                    <TextBlock Grid.Row="6" Grid.Column="2" TextWrapping="Wrap" Margin="0,2">
                        <Hyperlink NavigateUri="https://ifdian.net/a/zhangly1403" RequestNavigate="OnRequestNavigate">https://ifdian.net/a/zhangly1403</Hyperlink>
                    </TextBlock>
                </Grid>

                <GroupBox Header="GNU GPL v3.0 许可证声明" Margin="0,14,0,0">
                    <TextBox x:Name="TxtLicenseSummary" AcceptsReturn="True" TextWrapping="Wrap" IsReadOnly="True" VerticalScrollBarVisibility="Auto" MaxHeight="240" MinHeight="120" />
                </GroupBox>
            </StackPanel>
        </ScrollViewer>

        <TextBlock x:Name="TxtCopyright" Grid.Row="1" Margin="0,8,0,8" />

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="完整许可证" Margin="0,0,8,0" Click="OnOpenLicenseClick" />
            <Button Content="关闭"
                    IsDefault="True"
                    IsCancel="True"
                    Click="OnCloseClick" />
        </StackPanel>
    </Grid>
</Window>
