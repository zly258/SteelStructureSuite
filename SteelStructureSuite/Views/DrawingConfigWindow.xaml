<Window x:Class="SteelStructureSuite.Views.DrawingConfigWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="施工详图出图设置"
        Width="530" Height="530"
        MinWidth="490" MinHeight="480"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResize"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel>
                <GroupBox Header="图框与比例" Margin="0,0,0,8" Padding="10,8">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="120" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0" Text="标准图框幅面:" VerticalAlignment="Center" Margin="0,4" />
                        <ComboBox x:Name="CmbSheetSize" Grid.Row="0" Grid.Column="1" MinHeight="27" VerticalContentAlignment="Center" Padding="6,3" Margin="0,4" />

                        <TextBlock Grid.Row="1" Grid.Column="0" Text="绘图比例:" VerticalAlignment="Center" Margin="0,4" />
                        <ComboBox x:Name="CmbScale" Grid.Row="1" Grid.Column="1" MinHeight="27" VerticalContentAlignment="Center" Padding="6,3" Margin="0,4" />
                    </Grid>
                </GroupBox>

                <GroupBox Header="视图与标注选项" Margin="0,0,0,8" Padding="10,8">
                    <StackPanel>
                        <WrapPanel Margin="0,2,0,4">
                            <CheckBox x:Name="ChkFront" Content="正立面图" IsChecked="True" MinWidth="105" Margin="0,4,10,4" />
                            <CheckBox x:Name="ChkSide" Content="侧立面图" IsChecked="True" MinWidth="105" Margin="0,4,10,4" />
                            <CheckBox x:Name="ChkPlan" Content="平面图" IsChecked="True" MinWidth="95" Margin="0,4,10,4" />
                            <CheckBox x:Name="ChkIso" Content="轴测图" IsChecked="True" MinWidth="95" Margin="0,4,0,4" />
                        </WrapPanel>
                        <CheckBox x:Name="ChkDim" Content="正立面 / 侧立面 / 平面图标注标准设计轴网尺寸" IsChecked="True" Margin="0,5" />
                        <CheckBox x:Name="ChkLeader" Content="轴测图两侧标注水平件号引线 (#1, #2...)" IsChecked="True" Margin="0,5" />
                        <CheckBox x:Name="ChkBom" Content="标题栏上方内嵌国标材料明细表" IsChecked="True" Margin="0,5" />
                    </StackPanel>
                </GroupBox>

                <GroupBox Header="输出目标" Margin="0,0,0,8" Padding="10,8">
                    <StackPanel>
                        <RadioButton x:Name="RadCurrentDwg" Content="在当前 DWG 文件拾取插入点生成" IsChecked="True" Margin="0,4" Checked="OnOutputTargetChanged" />
                        <RadioButton x:Name="RadNewDwg" Content="单独创建新 DWG 图纸文件" IsChecked="False" Margin="0,4" Checked="OnOutputTargetChanged" />
                        <DockPanel Margin="18,4,0,4">
                            <Button x:Name="BtnBrowseDwg" DockPanel.Dock="Right" Content="浏览..." MinWidth="74" MinHeight="27" Padding="10,3" Margin="6,0,0,0" Click="OnBrowseNewDwgClick" />
                            <TextBox x:Name="TxtNewDwgPath" MinHeight="27" VerticalContentAlignment="Center" Padding="6,3" />
                        </DockPanel>
                        <CheckBox x:Name="ChkOpenAfterSave" Content="生成后在 AutoCAD 中自动打开新 DWG 文件" IsChecked="True" Margin="18,4,0,2" />
                    </StackPanel>
                </GroupBox>
            </StackPanel>
        </ScrollViewer>

        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
            <Button x:Name="BtnOk" Content="拾取点生成详图" MinWidth="140" MinHeight="30" Padding="14,5" Margin="6,2,0,2" IsDefault="True" Click="OnConfirmClick" />
            <Button Content="取消" MinWidth="80" MinHeight="30" Padding="14,5" Margin="6,2,0,2" IsCancel="True" Click="OnCancelClick" />
        </StackPanel>
    </Grid>
</Window>
