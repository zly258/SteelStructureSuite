<Window x:Class="SteelStructureSuite.Views.DrawingConfigWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="施工详图出图设置"
        Width="480" Height="480"
        MinWidth="450" MinHeight="450"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResize"
        UseLayoutRounding="True">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <GroupBox Grid.Row="0" Header="图框与比例" Margin="0,0,0,8" Padding="10,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="110" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Grid.Column="0" Text="标准图框幅面:" VerticalAlignment="Center" Margin="0,4" />
                <ComboBox x:Name="CmbSheetSize" Grid.Row="0" Grid.Column="1" VerticalContentAlignment="Center" Padding="4,3" Margin="0,4" />

                <TextBlock Grid.Row="1" Grid.Column="0" Text="绘图比例:" VerticalAlignment="Center" Margin="0,4" />
                <ComboBox x:Name="CmbScale" Grid.Row="1" Grid.Column="1" VerticalContentAlignment="Center" Padding="4,3" Margin="0,4" />
            </Grid>
        </GroupBox>

        <GroupBox Grid.Row="1" Header="视图与标注选项" Margin="0,0,0,8" Padding="10,8">
            <StackPanel>
                <WrapPanel Margin="0,2,0,4">
                    <CheckBox x:Name="ChkFront" Content="正立面图" IsChecked="True" Width="100" Margin="0,3" />
                    <CheckBox x:Name="ChkSide" Content="侧立面图" IsChecked="True" Width="100" Margin="0,3" />
                    <CheckBox x:Name="ChkPlan" Content="平面图" IsChecked="True" Width="90" Margin="0,3" />
                    <CheckBox x:Name="ChkIso" Content="轴测图" IsChecked="True" Width="90" Margin="0,3" />
                </WrapPanel>
                <CheckBox x:Name="ChkDim" Content="平/立面标注标准尺寸" IsChecked="True" Margin="0,4" />
                <CheckBox x:Name="ChkLeader" Content="轴测图标注序号引线 (#1, #2...)" IsChecked="True" Margin="0,4" />
                <CheckBox x:Name="ChkBom" Content="图框内嵌材料明细表" IsChecked="True" Margin="0,4" />
            </StackPanel>
        </GroupBox>

        <GroupBox Grid.Row="2" Header="输出目标" Margin="0,0,0,8" Padding="10,8">
            <StackPanel>
                <RadioButton x:Name="RadCurrentDwg" Content="在当前文件拾取点生成" IsChecked="True" Margin="0,4" Checked="OnOutputTargetChanged" />
                <RadioButton x:Name="RadNewDwg" Content="单独创建新 DWG 文件" IsChecked="False" Margin="0,4" Checked="OnOutputTargetChanged" />
                <DockPanel Margin="18,2,0,4">
                    <Button x:Name="BtnBrowseDwg" DockPanel.Dock="Right" Content="浏览..." MinWidth="68" Padding="8,3" Margin="6,0,0,0" Click="OnBrowseNewDwgClick" />
                    <TextBox x:Name="TxtNewDwgPath" VerticalContentAlignment="Center" Padding="4,3" />
                </DockPanel>
                <CheckBox x:Name="ChkOpenAfterSave" Content="生成后自动打开新 DWG 文件" IsChecked="True" Margin="18,2,0,2" />
            </StackPanel>
        </GroupBox>

        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button x:Name="BtnOk" Content="拾取点生成详图" MinWidth="135" Padding="12,5" Margin="6,2,0,2" IsDefault="True" Click="OnConfirmClick" />
            <Button Content="取消" MinWidth="75" Padding="12,5" Margin="6,2,0,2" IsCancel="True" Click="OnCancelClick" />
        </StackPanel>
    </Grid>
</Window>
