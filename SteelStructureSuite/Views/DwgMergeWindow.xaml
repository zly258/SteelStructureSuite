<Window x:Class="SteelStructureSuite.Views.DwgMergeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="合并图纸"
        Width="780"
        Height="700"
        MinWidth="640"
        MinHeight="540"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResize"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/SteelStructureSuite;component/Views/Styles/DefaultMetrics.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <!-- layout-check: allow-fixed-window-height（文件列表与日志需要固定视口，内部独立滚动） -->
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="1.3*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 页头：标题 + 一行说明 -->
        <StackPanel Grid.Row="0" Margin="0,0,0,8">
            <TextBlock Text="合并图纸" FontWeight="SemiBold" />
            <TextBlock Text="支持 DWG 与 DXF 混排，按模型空间范围横向或纵向排布" Margin="0,2,0,0" />
        </StackPanel>

        <!-- 待合并文件 -->
        <Border Grid.Row="1" Style="{StaticResource Panel.Card}" Margin="0,0,0,8">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,6">
                    <TextBlock Text="图纸文件" VerticalAlignment="Center" />
                    <Border Style="{StaticResource Panel.Badge}" Margin="8,0,0,0">
                        <TextBlock x:Name="TxtFileCount" Text="0" />
                    </Border>
                </StackPanel>
                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" MinWidth="240" />
                        <ColumnDefinition Width="8" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <ListBox x:Name="LstFiles" HorizontalContentAlignment="Stretch">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Name}" ToolTip="{Binding FullPath}" TextTrimming="CharacterEllipsis" />
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <StackPanel Grid.Column="2" VerticalAlignment="Top">
                        <Button Content="添加" Margin="0,0,0,6" Click="OnAddClick" />
                        <Button Content="移除" Margin="0,0,0,6" Click="OnRemoveClick" />
                        <Button Content="上移" Margin="0,0,0,6" Click="OnUpClick" />
                        <Button Content="下移" Margin="0,0,0,6" Click="OnDownClick" />
                        <Button Content="清空" Click="OnClearClick" />
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>

        <!-- 排布与输出参数（统一单 Grid 共享标签列，保证左边界对齐） -->
        <Border Grid.Row="2" Style="{StaticResource Panel.Card}" Margin="0,0,0,8">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Row="0" Grid.Column="0" Text="排列" />
                <StackPanel Grid.Row="0" Grid.Column="1" Grid.ColumnSpan="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <RadioButton x:Name="RadHorizontal" Content="横向" GroupName="MergeDir" IsChecked="True" Margin="0,0,16,0" />
                    <RadioButton x:Name="RadVertical" Content="纵向" GroupName="MergeDir" />
                </StackPanel>

                <TextBlock Grid.Row="1" Grid.Column="0" Text="间距" />
                <TextBox x:Name="TxtGap" Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2"
                         ToolTip="相邻图纸范围之间的间距，单位与图纸一致" />

                <CheckBox x:Name="ChkExplode" Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="2"
                          Content="分解到模型空间"
                          ToolTip="不勾选时每张图放入一个图块；勾选后分解成普通图元" />

                <TextBlock Grid.Row="3" Grid.Column="0" Text="输出文件" />
                <TextBox x:Name="TxtOutput" Grid.Row="3" Grid.Column="1"
                         ToolTip="输出文件名，必须带 .dwg 或 .dxf 扩展名；只填文件名时保存到第一个源文件所在目录" />
                <Button Grid.Row="3" Grid.Column="2" Content="浏览"
                        Margin="8,3,0,3" Click="OnBrowseOutputClick" />
            </Grid>
        </Border>

        <!-- 日志 -->
        <Border Grid.Row="3" Style="{StaticResource Panel.Card}" Margin="0,0,0,8">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0" Text="合并日志" Margin="0,0,0,6" />
                <TextBox x:Name="TxtLog" Grid.Row="1" AcceptsReturn="True" TextWrapping="Wrap" IsReadOnly="True" VerticalScrollBarVisibility="Auto"
                         MaxHeight="Infinity" VerticalAlignment="Stretch" HorizontalScrollBarVisibility="Auto" />
            </Grid>
        </Border>

        <CheckBox x:Name="ChkOpen" Grid.Row="4" Content="完成后打开" Margin="0,0,0,8" ToolTip="合并完成后在 AutoCAD 中打开输出图纸" />

        <StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button x:Name="BtnRun" Content="开始合并" Margin="0,0,8,0" Click="OnMergeClick" />
            <Button Content="关闭" Click="OnCloseClick" />
        </StackPanel>
    </Grid>
</Window>
