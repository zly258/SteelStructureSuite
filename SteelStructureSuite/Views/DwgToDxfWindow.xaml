<Window x:Class="SteelStructureSuite.Views.DwgToDxfWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="批量 DWG 转 DXF"
        Width="780"
        Height="680"
        MinWidth="640"
        MinHeight="520"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResize"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/SteelStructureSuite;component/Views/Styles/DefaultMetrics.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <!-- layout-check: allow-fixed-window-height（文件列表与日志需要固定视口，内部独立滚动） -->
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="1.4*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,8">
            <TextBlock Text="批量 DWG 转 DXF" FontWeight="SemiBold" />
            <TextBlock Text="按当前 AutoCAD 支持的版本批量导出 DXF" Margin="0,2,0,0" />
        </StackPanel>

        <Border Grid.Row="1" Margin="0,0,0,8">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,6">
                    <TextBlock Text="源图纸" VerticalAlignment="Center" />
                    <Border Margin="8,0,0,0" VerticalAlignment="Center">
                        <TextBlock x:Name="TxtFileCount" Text="0" />
                    </Border>
                </StackPanel>
                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" MinWidth="240" />
                        <ColumnDefinition Width="8" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <ListBox x:Name="LstFiles" HorizontalContentAlignment="Stretch">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Name}" ToolTip="{Binding FullPath}" TextTrimming="CharacterEllipsis" />
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <StackPanel Grid.Column="2" VerticalAlignment="Top">
                        <Button Content="添加" Margin="0,0,0,6" Click="OnAddClick" />
                        <Button Content="移除" Margin="0,0,0,6" Click="OnRemoveClick" />
                        <Button Content="上移" Margin="0,0,0,6" Click="OnUpClick" />
                        <Button Content="下移" Margin="0,0,0,6" Click="OnDownClick" />
                        <Button Content="清空" Click="OnClearClick" />
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>

        <Border Grid.Row="2" Margin="0,0,0,8">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Row="0" Grid.Column="0" Text="输出目录" />
                <TextBox x:Name="TxtOutput" Grid.Row="0" Grid.Column="1" ToolTip="DXF 输出目录" />
                <Button Grid.Row="0" Grid.Column="2" Content="浏览" Margin="8,3,0,3" Click="OnBrowseOutputClick" />

                <TextBlock Grid.Row="1" Grid.Column="0" Text="DXF 版本" />
                <ComboBox x:Name="CmbVersion" Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2">
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Label}" ToolTip="{Binding Label}" TextTrimming="CharacterEllipsis" />
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>

                <CheckBox x:Name="ChkOverwrite" Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="2" Content="覆盖已有 DXF" />
            </Grid>
        </Border>

        <Border Grid.Row="3" Margin="0,0,0,8">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0" Text="转换日志" Margin="0,0,0,6" />
                <TextBox x:Name="TxtLog" Grid.Row="1" AcceptsReturn="True" TextWrapping="Wrap" IsReadOnly="True" VerticalScrollBarVisibility="Auto"
                         MaxHeight="Infinity" VerticalAlignment="Stretch" HorizontalScrollBarVisibility="Auto" />
            </Grid>
        </Border>

        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="打开目录" Margin="0,0,8,0" Click="OnOpenFolderClick" />
            <Button x:Name="BtnRun" Content="开始转换" Margin="0,0,8,0" Click="OnConvertClick" />
            <Button Content="关闭" Click="OnCloseClick" />
        </StackPanel>
    </Grid>
</Window>
