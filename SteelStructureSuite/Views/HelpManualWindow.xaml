<Window x:Class="SteelStructureSuite.Views.HelpManualWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="参数化钢结构套件 - 使用说明"
        Width="680"
        Height="560"
        MinWidth="520"
        MinHeight="420"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResize"
        FontSize="{DynamicResource FontSize.Body}"
        Background="{DynamicResource Brush.WindowBackground}"
        Foreground="{DynamicResource Brush.Text.Primary}"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display">
    <Window.FontFamily>
        <DynamicResource ResourceKey="Font.Ui" />
    </Window.FontFamily>
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/SteelStructureSuite;component/Theme/Theme.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>
    <Grid Margin="{StaticResource Layout.WindowPadding}">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Style="{StaticResource Card}">
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <TextBlock x:Name="TxtManual" TextWrapping="Wrap" />
            </ScrollViewer>
        </Border>

        <Button Grid.Row="1"
                Content="关闭"
                MinWidth="{StaticResource Layout.ButtonMinWidth}"
                Style="{StaticResource Button.Primary}"
                Margin="0,8,0,0"
                HorizontalAlignment="Right"
                IsDefault="True"
                IsCancel="True"
                Click="OnCloseClick" />
    </Grid>
</Window>
