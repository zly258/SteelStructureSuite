<Window x:Class="SteelStructureSuite.Views.MaterialTakeoffWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="钢结构材料统计 (MTO / BOM)"
        Width="1040" Height="600"
        MinWidth="880" MinHeight="480"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResize"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0" Margin="0,0,0,8">
            <WrapPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Button Content="全图统计" MinWidth="98" MinHeight="28" Padding="10,4" Margin="6,2,0,2" Click="OnAllScopeClick" />
                <Button Content="框选统计" MinWidth="98" MinHeight="28" Padding="10,4" Margin="6,2,0,2" Click="OnPickSelectionClick" />
            </WrapPanel>
            <TextBlock x:Name="TxtBanner" VerticalAlignment="Center" FontWeight="Bold" TextTrimming="CharacterEllipsis" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" Margin="0,0,8,0" />
        </DockPanel>

        <TabControl Grid.Row="1" Margin="0,0,0,8">
            <TabItem Header="1. 规格材料汇总表" Padding="14,5">
                <DataGrid x:Name="DgSummary"
                          AutoGenerateColumns="False"
                          CanUserAddRows="False"
                          IsReadOnly="True"
                          RowHeaderWidth="0"
                          HorizontalScrollBarVisibility="Auto"
                          VerticalScrollBarVisibility="Auto"
                          Margin="4">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="序号" Binding="{Binding Index}" Width="55" MinWidth="48" />
                        <DataGridTextColumn Header="对应件号" Binding="{Binding PartNoRange}" Width="0.9*" MinWidth="80" />
                        <DataGridTextColumn Header="截面规格" Binding="{Binding SectionName}" Width="1.35*" MinWidth="125" />
                        <DataGridTextColumn Header="型钢类别" Binding="{Binding ShapeTypeName}" Width="0.9*" MinWidth="80" />
                        <DataGridTextColumn Header="材质" Binding="{Binding Material}" Width="0.75*" MinWidth="68" />
                        <DataGridTextColumn Header="总件数" Binding="{Binding TotalCount}" Width="0.7*" MinWidth="65" />
                        <DataGridTextColumn Header="总长(m)" Binding="{Binding TotalLengthM, StringFormat=0.00}" Width="0.9*" MinWidth="80" />
                        <DataGridTextColumn Header="单重(kg/m)" Binding="{Binding UnitWeightKgPerM, StringFormat=0.00}" Width="0.95*" MinWidth="88" />
                        <DataGridTextColumn Header="总重(kg)" Binding="{Binding TotalWeightKg, StringFormat=0.00}" Width="0.95*" MinWidth="88" />
                        <DataGridTextColumn Header="刷漆面积(m²)" Binding="{Binding TotalSurfaceAreaM2, StringFormat=0.00}" Width="1.0*" MinWidth="95" />
                    </DataGrid.Columns>
                </DataGrid>
            </TabItem>
            <TabItem Header="2. 构件零件明细表 (#1, #2...)" Padding="14,5">
                <DataGrid x:Name="DgDetails"
                          AutoGenerateColumns="False"
                          CanUserAddRows="False"
                          IsReadOnly="True"
                          RowHeaderWidth="0"
                          HorizontalScrollBarVisibility="Auto"
                          VerticalScrollBarVisibility="Auto"
                          Margin="4">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="位号" Binding="{Binding ParentTag}" Width="0.85*" MinWidth="75" />
                        <DataGridTextColumn Header="件号" Binding="{Binding PartNo, StringFormat=#{0}}" Width="62" MinWidth="54" />
                        <DataGridTextColumn Header="部位" Binding="{Binding PartRole}" Width="1.2*" MinWidth="110" />
                        <DataGridTextColumn Header="截面规格" Binding="{Binding SectionName}" Width="1.3*" MinWidth="125" />
                        <DataGridTextColumn Header="类别" Binding="{Binding ShapeTypeName}" Width="0.85*" MinWidth="75" />
                        <DataGridTextColumn Header="材质" Binding="{Binding Material}" Width="0.75*" MinWidth="68" />
                        <DataGridTextColumn Header="件数" Binding="{Binding Count}" Width="60" MinWidth="52" />
                        <DataGridTextColumn Header="单长(mm)" Binding="{Binding SingleLengthMm, StringFormat=0}" Width="0.9*" MinWidth="82" />
                        <DataGridTextColumn Header="单重(kg/m)" Binding="{Binding UnitWeightKgPerM, StringFormat=0.00}" Width="0.9*" MinWidth="85" />
                        <DataGridTextColumn Header="小计重(kg)" Binding="{Binding TotalWeightKg, StringFormat=0.00}" Width="0.9*" MinWidth="85" />
                        <DataGridTextColumn Header="面积(m²)" Binding="{Binding TotalSurfaceAreaM2, StringFormat=0.00}" Width="0.9*" MinWidth="82" />
                    </DataGrid.Columns>
                </DataGrid>
            </TabItem>
        </TabControl>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="导出 Excel (.xlsx)" MinWidth="140" MinHeight="29" Padding="12,4" Margin="6,2,0,2" Click="OnExportExcelClick" />
            <Button Content="插入 CAD 汇总表" MinWidth="140" MinHeight="29" Padding="12,4" Margin="6,2,0,2" Click="OnInsertSummaryClick" />
            <Button Content="插入 CAD 明细表" MinWidth="140" MinHeight="29" Padding="12,4" Margin="6,2,0,2" Click="OnInsertDetailClick" />
            <Button Content="关闭" MinWidth="82" MinHeight="29" Padding="12,4" Margin="6,2,0,2" IsCancel="True" Click="OnCloseClick" />
        </StackPanel>
    </Grid>
</Window>
