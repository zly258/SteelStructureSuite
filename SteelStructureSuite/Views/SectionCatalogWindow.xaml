<Window x:Class="SteelStructureSuite.Views.SectionCatalogWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="型钢截面库"
        Width="980"
        Height="680"
        MinWidth="840"
        MinHeight="420"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResize"
        FontSize="{DynamicResource FontSize.Body}"
        Background="{DynamicResource Brush.WindowBackground}"
        Foreground="{DynamicResource Brush.Text.Primary}"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display">
    <Window.FontFamily>
        <DynamicResource ResourceKey="Font.Ui" />
    </Window.FontFamily>
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/SteelStructureSuite;component/Theme/Theme.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>
    <!-- layout-check: allow-fixed-window-height（型钢库表格需要固定视口，数据区独立滚动） -->
    <Grid Margin="{StaticResource Layout.WindowPadding}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock x:Name="TxtSummary" Grid.Row="0" Style="{StaticResource Text.Title}" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,0,0,8" />

        <Border Grid.Row="1" Style="{StaticResource ToolStrip}" Margin="0,0,0,8">
            <StackPanel Orientation="Horizontal">
                <Button Content="导入" ToolTip="从 Excel 或 CSV 导入截面" MinWidth="{StaticResource Layout.ButtonMinWidth}" Margin="0,0,8,0" Click="OnImportClick" />
                <Button Content="Excel" ToolTip="导出多工作表 Excel" MinWidth="{StaticResource Layout.ButtonMinWidth}" Margin="0,0,8,0" Click="OnExportXlsxClick" />
                <Button Content="CSV" ToolTip="导出 CSV" MinWidth="{StaticResource Layout.ButtonMinWidth}" Margin="0,0,8,0" Click="OnExportCsvClick" />
                <Button Content="恢复默认库" MinWidth="{StaticResource Layout.ButtonMinWidth}" Style="{StaticResource Button.Danger}" Click="OnResetDefaultClick" />
            </StackPanel>
        </Border>

        <Grid Grid.Row="2" Margin="0,0,0,4">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <ListBox x:Name="LstSections"
                     SelectionChanged="OnSectionSelectionChanged"
                     MaxHeight="{StaticResource Layout.LogMaxHeight}"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     ScrollViewer.VerticalScrollBarVisibility="Auto">
                <ListBox.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel Orientation="Horizontal" />
                    </ItemsPanelTemplate>
                </ListBox.ItemsPanel>
            </ListBox>
            <ContentControl x:Name="SectionHost" Grid.Row="1" Margin="0,4,0,0" />
        </Grid>

        <GroupBox Grid.Row="3" Header="新增 / 更新截面">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" MinWidth="110" />
                    <ColumnDefinition Width="10" />
                    <ColumnDefinition Width="1.4*" MinWidth="140" />
                    <ColumnDefinition Width="10" />
                    <ColumnDefinition Width="*" MinWidth="90" />
                    <ColumnDefinition Width="10" />
                    <ColumnDefinition Width="*" MinWidth="90" />
                    <ColumnDefinition Width="10" />
                    <ColumnDefinition Width="*" MinWidth="90" />
                    <ColumnDefinition Width="10" />
                    <ColumnDefinition Width="*" MinWidth="90" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Text="所属分表" Style="{StaticResource Text.Caption}" Margin="{StaticResource Layout.FormRowMargin}" />
                    <ComboBox x:Name="CmbType" />
                </StackPanel>
                <StackPanel Grid.Column="2">
                    <TextBlock Text="截面代号" Style="{StaticResource Text.Caption}" Margin="{StaticResource Layout.FormRowMargin}" />
                    <TextBox x:Name="TxtName" Text="HM294x200x8x12" />
                </StackPanel>
                <StackPanel Grid.Column="4">
                    <TextBlock Text="高度 H" Style="{StaticResource Text.Caption}" Margin="{StaticResource Layout.FormRowMargin}" />
                    <TextBox x:Name="TxtH" Text="294" ToolTip="高度或外径，单位 mm" />
                </StackPanel>
                <StackPanel Grid.Column="6">
                    <TextBlock Text="宽度 B" Style="{StaticResource Text.Caption}" Margin="{StaticResource Layout.FormRowMargin}" />
                    <TextBox x:Name="TxtB" Text="200" ToolTip="宽度，单位 mm" />
                </StackPanel>
                <StackPanel Grid.Column="8">
                    <TextBlock Text="腹板 tw" Style="{StaticResource Text.Caption}" Margin="{StaticResource Layout.FormRowMargin}" />
                    <TextBox x:Name="TxtTw" Text="8" ToolTip="腹板或壁厚，单位 mm" />
                </StackPanel>
                <StackPanel Grid.Column="10">
                    <TextBlock Text="翼缘 tf" Style="{StaticResource Text.Caption}" Margin="{StaticResource Layout.FormRowMargin}" />
                    <TextBox x:Name="TxtTf" Text="12" ToolTip="翼缘厚度，单位 mm" />
                </StackPanel>
            </Grid>
        </GroupBox>

        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="添加 / 更新" MinWidth="{StaticResource Layout.ButtonMinWidth}" Margin="0,0,8,0" Click="OnAddSectionClick" />
            <Button Content="删除选中项" MinWidth="{StaticResource Layout.ButtonMinWidth}" Style="{StaticResource Button.Danger}" Margin="0,0,8,0" Click="OnDeleteSectionClick" />
            <Button Content="保存并关闭" MinWidth="{StaticResource Layout.ButtonMinWidth}" Style="{StaticResource Button.Primary}" IsDefault="True" Click="OnSaveCloseClick" />
        </StackPanel>
    </Grid>
</Window>
