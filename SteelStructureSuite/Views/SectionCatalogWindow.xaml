<Window x:Class="SteelStructureSuite.Views.SectionCatalogWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:SteelStructureSuite.Views.Controls"
        Title="型钢截面库管理"
        Width="1180"
        Height="820"
        MinWidth="920"
        MinHeight="600"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResize"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/SteelStructureSuite;component/Views/Styles/DefaultMetrics.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <!-- layout-check: allow-fixed-window-height（型钢库树与表格需要固定视口，数据区独立滚动） -->
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Zone 1: 页头汇总与全局库操作 -->
        <Border Grid.Row="0" Margin="0,0,0,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="TxtSummary"
                           Grid.Column="0"
                           FontWeight="SemiBold"
                           VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis"
                           ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" />
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="导入" ToolTip="从 Excel (.xlsx) 或 CSV 导入截面" Margin="0,0,8,0" Click="OnImportClick" />
                    <Button Content="导出 Excel" ToolTip="按 5 大类分工作表导出 Excel" Margin="0,0,8,0" Click="OnExportXlsxClick" />
                    <Button Content="导出 CSV" ToolTip="导出全部截面为 CSV" Margin="0,0,8,0" Click="OnExportCsvClick" />
                    <Button Content="恢复默认库" ToolTip="重置为内置国标与工程截面库" Click="OnResetDefaultClick" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- Zone 2 & 3: 左侧分类树 + 右侧筛选与截面表格 -->
        <Grid Grid.Row="1" Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="236" MinWidth="180" MaxWidth="340" />
                <ColumnDefinition Width="8" />
                <ColumnDefinition Width="*" MinWidth="500" />
            </Grid.ColumnDefinitions>

            <!-- 左侧分类树：外框 1px 描边 + 标题栏分隔线，树本身不再重复描边 -->
            <Border Grid.Column="0"
                    BorderBrush="{x:Static SystemColors.ControlDarkBrush}"
                    BorderThickness="1"
                    SnapsToDevicePixels="True">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Border Grid.Row="0"
                            Background="{x:Static SystemColors.ControlBrush}"
                            BorderBrush="{x:Static SystemColors.ControlDarkBrush}"
                            BorderThickness="0,0,0,1"
                            Padding="10,6">
                        <TextBlock Text="截面分类树" FontWeight="SemiBold" />
                    </Border>
                    <TreeView x:Name="TreeCategories"
                              Grid.Row="1"
                              BorderThickness="0"
                              SelectedItemChanged="OnTreeCategorySelected" />
                </Grid>
            </Border>

            <GridSplitter Grid.Column="1"
                          Width="8"
                          HorizontalAlignment="Stretch"
                          VerticalAlignment="Stretch"
                          Background="Transparent"
                          ResizeBehavior="PreviousAndNext" />

            <!-- 右侧筛选栏 + 数据表格 -->
            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- 范围筛选栏 -->
                <Border Grid.Row="0" Margin="0,0,0,8">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" MinWidth="140" />
                            <ColumnDefinition Width="8" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="TxtCurrentCategory"
                                   Grid.Column="0"
                                   Text="全部截面"
                                   FontWeight="SemiBold"
                                   VerticalAlignment="Center" />
                        <TextBlock Grid.Column="2"
                                   Text="筛选"
                                   VerticalAlignment="Center"
                                   Margin="0,0,6,0" />
                        <TextBox x:Name="TxtSearch"
                                 Grid.Column="3"
                                 ToolTip="按截面代号或类型名称模糊搜索"
                                 TextChanged="OnSearchTextChanged" />
                        <Button Grid.Column="5"
                                Content="清除"
                                Click="OnClearSearchClick" />
                        <Border Grid.Column="7"
                                Padding="8,3"
                                VerticalAlignment="Center">
                            <TextBlock x:Name="TxtFilteredCount"
                                       Text="0 项" />
                        </Border>
                    </Grid>
                </Border>

                <!-- 截面规格数据表 -->
                <DataGrid x:Name="GridSections"
                          Grid.Row="1"
                          AutoGenerateColumns="False"
                          CanUserAddRows="False"
                          IsReadOnly="True"
                          SelectionMode="Single"
                          RowHeaderWidth="0"
                          HorizontalScrollBarVisibility="Auto"
                          VerticalScrollBarVisibility="Auto"
                          SelectionChanged="OnGridSelectionChanged">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="截面代号" Binding="{Binding Name}" Width="1.5*" MinWidth="135" />
                        <DataGridTextColumn Header="所属类型" Binding="{Binding ShapeTypeDisplayName}" Width="1.15*" MinWidth="105" />
                        <DataGridTextColumn Header="高度/外径 H" Binding="{Binding H, StringFormat=0.##}" Width="0.85*" MinWidth="82" />
                        <DataGridTextColumn Header="宽度 B" Binding="{Binding B, StringFormat=0.##}" Width="0.75*" MinWidth="68" />
                        <DataGridTextColumn Header="腹板/壁厚 tw" Binding="{Binding Tw, StringFormat=0.##}" Width="0.85*" MinWidth="85" />
                        <DataGridTextColumn Header="翼缘厚 tf" Binding="{Binding Tf, StringFormat=0.##}" Width="0.75*" MinWidth="72" />
                        <DataGridTextColumn Header="扩展参数" Binding="{Binding ExtraParamsSummary}" Width="1.1*" MinWidth="92" />
                        <DataGridTextColumn Header="截面积 (cm²)" Binding="{Binding AreaCm2, StringFormat=0.00}" Width="0.9*" MinWidth="86" />
                        <DataGridTextColumn Header="单重 (kg/m)" Binding="{Binding UnitWeightKgPerM, StringFormat=0.00}" Width="0.85*" MinWidth="82" />
                        <DataGridTextColumn Header="表面积 (m²/m)" Binding="{Binding PerimeterMPerM, StringFormat=0.000}" Width="0.9*" MinWidth="88" />
                        <DataGridTextColumn Header="数据来源" Binding="{Binding PropertySourceDisplayName}" Width="0.85*" MinWidth="78" />
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Grid>

        <!-- Zone 3.5: 左图右参数（左列 2D 轮廓，右列分组参数；分组用细标签 + 缩进，不用 GroupBox） -->
        <Grid Grid.Row="2" Height="Auto" Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="260" MinWidth="200" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="*" MinWidth="440" />
            </Grid.ColumnDefinitions>

            <!-- 左：2D 截面示意 -->
            <Border Grid.Column="0"
                    BorderBrush="{x:Static SystemColors.ControlDarkBrush}"
                    BorderThickness="1"
                    SnapsToDevicePixels="True">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Border Grid.Row="0"
                            Background="{x:Static SystemColors.ControlBrush}"
                            BorderBrush="{x:Static SystemColors.ControlDarkBrush}"
                            BorderThickness="0,0,0,1"
                            Padding="10,5">
                        <TextBlock Text="2D 截面示意" FontWeight="SemiBold" />
                    </Border>
                    <controls:SectionPreviewControl x:Name="PreviewControl" Grid.Row="1" MinHeight="150" Margin="6" />
                </Grid>
            </Border>

            <!-- 右：参数编辑（分组标题 + 缩进；每行两组「标签 + 控件」，整体高度紧凑） -->
            <Border Grid.Column="2"
                    BorderBrush="{x:Static SystemColors.ControlDarkBrush}"
                    BorderThickness="1"
                    SnapsToDevicePixels="True">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Border Grid.Row="0"
                            Background="{x:Static SystemColors.ControlBrush}"
                            BorderBrush="{x:Static SystemColors.ControlDarkBrush}"
                            BorderThickness="0,0,0,1"
                            Padding="10,5">
                        <TextBlock Text="新增 / 更新截面参数" FontWeight="SemiBold" />
                    </Border>

                    <ScrollViewer Grid.Row="1"
                                  VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled">
                        <StackPanel Margin="10,6,12,8" Grid.IsSharedSizeScope="True">

                            <!-- 分组：基本标识 -->
                            <TextBlock Text="基本标识"
                                       FontWeight="SemiBold"
                                       Foreground="{x:Static SystemColors.GrayTextBrush}"
                                       Margin="0,0,0,3" />
                            <Grid Margin="12,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" MinWidth="82" SharedSizeGroup="SecLabel" />
                                    <ColumnDefinition Width="*" MinWidth="96" />
                                    <ColumnDefinition Width="16" />
                                    <ColumnDefinition Width="Auto" MinWidth="82" SharedSizeGroup="SecLabel" />
                                    <ColumnDefinition Width="*" MinWidth="96" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0" Grid.Column="0" Text="截面类型" VerticalAlignment="Center" />
                                <ComboBox x:Name="CmbType" Grid.Row="0" Grid.Column="1" SelectionChanged="OnEditTypeChanged" />

                                <TextBlock Grid.Row="0" Grid.Column="3" Text="截面代号" VerticalAlignment="Center" />
                                <TextBox x:Name="TxtName" Grid.Row="0" Grid.Column="4" Text="HW200x200x8x12" ToolTip="自定义或国标截面代号，如 HW200x200x8x12、C160x60x20x2.5" />
                            </Grid>

                            <!-- 分组：几何尺寸 (mm)，仅显示当前截面所需字段；每行两组「标签 + 控件」 -->
                            <TextBlock Text="几何尺寸 (mm)"
                                       FontWeight="SemiBold"
                                       Foreground="{x:Static SystemColors.GrayTextBrush}"
                                       Margin="0,0,0,3" />
                            <Grid Margin="12,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" MinWidth="170" />
                                    <ColumnDefinition Width="18" />
                                    <ColumnDefinition Width="*" MinWidth="170" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <Grid x:Name="PanelH" Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" MinWidth="82" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock x:Name="LblH" Text="高度 H" VerticalAlignment="Center" />
                                    <TextBox x:Name="TxtH" Grid.Column="1" Text="200" ToolTip="截面高度或外径，单位 mm" TextChanged="OnParamInputChanged" />
                                </Grid>

                                <Grid x:Name="PanelB" Grid.Row="0" Grid.Column="2" Grid.ColumnSpan="2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" MinWidth="82" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock x:Name="LblB" Text="宽度 B" VerticalAlignment="Center" />
                                    <TextBox x:Name="TxtB" Grid.Column="1" Text="200" ToolTip="截面宽度或上翼缘宽，单位 mm" TextChanged="OnParamInputChanged" />
                                </Grid>

                                <Grid x:Name="PanelTw" Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" Margin="0,6,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" MinWidth="82" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock x:Name="LblTw" Text="腹板 tw" VerticalAlignment="Center" />
                                    <TextBox x:Name="TxtTw" Grid.Column="1" Text="8" ToolTip="腹板厚或管壁厚，单位 mm" TextChanged="OnParamInputChanged" />
                                </Grid>

                                <Grid x:Name="PanelTf" Grid.Row="1" Grid.Column="2" Grid.ColumnSpan="2" Margin="0,6,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" MinWidth="82" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock x:Name="LblTf" Text="翼缘 tf" VerticalAlignment="Center" />
                                    <TextBox x:Name="TxtTf" Grid.Column="1" Text="12" ToolTip="翼缘厚度或上翼缘厚，单位 mm" TextChanged="OnParamInputChanged" />
                                </Grid>

                                <Grid x:Name="PanelB2" Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2" Visibility="Collapsed" Margin="0,6,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" MinWidth="82" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="下翼缘宽 B2" VerticalAlignment="Center" />
                                    <TextBox x:Name="TxtB2" Grid.Column="1" Text="240" ToolTip="不等翼缘焊接H型钢下翼缘宽度 (mm)" TextChanged="OnParamInputChanged" />
                                </Grid>

                                <Grid x:Name="PanelTf2" Grid.Row="2" Grid.Column="2" Grid.ColumnSpan="2" Visibility="Collapsed" Margin="0,6,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" MinWidth="82" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="下翼缘厚 tf2" VerticalAlignment="Center" />
                                    <TextBox x:Name="TxtTf2" Grid.Column="1" Text="16" ToolTip="不等翼缘焊接H型钢下翼缘厚度 (mm)" TextChanged="OnParamInputChanged" />
                                </Grid>

                                <Grid x:Name="PanelLip" Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="2" Visibility="Collapsed" Margin="0,6,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" MinWidth="82" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock x:Name="LblLip" Text="卷边高度 C" VerticalAlignment="Center" />
                                    <TextBox x:Name="TxtLip" Grid.Column="1" Text="20" ToolTip="冷弯卷边高度或帽型钢外翻边宽 (mm)" TextChanged="OnParamInputChanged" />
                                </Grid>

                                <Grid x:Name="PanelGap" Grid.Row="3" Grid.Column="2" Grid.ColumnSpan="2" Visibility="Collapsed" Margin="0,6,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" MinWidth="82" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="双拼间隙 Gap" VerticalAlignment="Center" />
                                    <TextBox x:Name="TxtGap" Grid.Column="1" Text="10" ToolTip="双拼截面中间节点板间隙 (mm)" TextChanged="OnParamInputChanged" />
                                </Grid>

                            </Grid>

                            <!-- 分组：物理特性（支持国标手册值/手工修正，或一键按公式重算） -->
                            <TextBlock Text="物理特性"
                                       FontWeight="SemiBold"
                                       Foreground="{x:Static SystemColors.GrayTextBrush}"
                                       Margin="0,0,0,3" />
                            <Grid Margin="12,0,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" MinWidth="82" SharedSizeGroup="SecLabel" />
                                    <ColumnDefinition Width="*" MinWidth="96" />
                                    <ColumnDefinition Width="16" />
                                    <ColumnDefinition Width="Auto" MinWidth="82" SharedSizeGroup="SecLabel" />
                                    <ColumnDefinition Width="*" MinWidth="96" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0" Grid.Column="0" Text="截面积 (cm²)" VerticalAlignment="Center" />
                                <TextBox x:Name="TxtArea" Grid.Row="0" Grid.Column="1" ToolTip="可直接修改为国标手册值；留空或点右侧重算则按几何公式计算" TextChanged="OnManualMetricChanged" />

                                <TextBlock Grid.Row="0" Grid.Column="3" Text="理论单重 (kg/m)" VerticalAlignment="Center" />
                                <TextBox x:Name="TxtWeight" Grid.Row="0" Grid.Column="4" ToolTip="可直接修改为国标手册米重；留空或点右侧重算则按几何公式计算" TextChanged="OnManualMetricChanged" />

                                <TextBlock Grid.Row="1" Grid.Column="0" Text="表面积 (m²/m)" VerticalAlignment="Center" Margin="0,6,0,0" />
                                <TextBox x:Name="TxtSurface" Grid.Row="1" Grid.Column="1" ToolTip="可直接修改为国标手册表面积；留空或点右侧重算则按几何公式计算" TextChanged="OnManualMetricChanged" Margin="0,6,0,0" />

                                <StackPanel Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="5"
                                            Orientation="Horizontal"
                                            Margin="0,8,0,0">
                                    <Border BorderBrush="{x:Static SystemColors.ControlDarkBrush}"
                                            BorderThickness="1"
                                            Padding="8,3"
                                            VerticalAlignment="Center">
                                        <TextBlock x:Name="TxtMetricSource" Text="公式计算" />
                                    </Border>
                                    <Button Content="按公式重算"
                                            ToolTip="清除手册/自定义覆盖值，按当前几何尺寸公式重新计算"
                                            Margin="10,0,0,0"
                                            Click="OnRecalcMetricsClick" />
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>

        <!-- Zone 3.8: 数据存储路径与格式说明（独占底部操作栏上方一行） -->
        <Border Grid.Row="3"
                BorderThickness="1"
                Padding="10,4"
                Margin="0,0,0,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="8" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="TxtStorageInfo"
                           Grid.Column="0"
                           VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis"
                           ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" />
                <Button Grid.Column="2"
                        Content="打开目录"
                        ToolTip="在文件资源管理器中定位本地截面库 CSV 文件"
                        Click="OnOpenStorageFolderClick" />
            </Grid>
        </Border>

        <!-- Zone 4: 底部操作栏 -->
        <Grid Grid.Row="4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" Orientation="Horizontal">
                <Button Content="新增 / 更新" Margin="0,0,8,0" Click="OnAddSectionClick" />
                <Button x:Name="BtnDelete" Content="删除选中项" IsEnabled="False" Click="OnDeleteSectionClick" />
            </StackPanel>
            <Button Grid.Column="2" Content="保存并关闭" IsDefault="True" Click="OnSaveCloseClick" />
        </Grid>
    </Grid>
</Window>
