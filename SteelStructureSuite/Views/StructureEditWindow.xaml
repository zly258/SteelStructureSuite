<Window x:Class="SteelStructureSuite.Views.StructureEditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:SteelStructureSuite.Views.Controls"
        Title="参数化钢结构"
        Width="680"
        Height="720"
        MinWidth="560"
        MinHeight="460"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResize"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/SteelStructureSuite;component/Views/Styles/DefaultMetrics.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TabControl Grid.Row="0">
            <TabItem x:Name="TbiParams" Header="参数与示意">
            <Grid x:Name="ParamsPanel">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <controls:StructureSchematicControl x:Name="SchematicView" Grid.Row="0" VerticalAlignment="Top" />
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel Margin="0,8,0,0" Grid.IsSharedSizeScope="True">
                            <GroupBox Header="基本属性">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" SharedSizeGroup="EditFormLabel" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <TextBlock x:Name="LblType" Grid.Row="0" Grid.Column="0" Text="结构类型" />
                                    <ComboBox x:Name="CmbStructureType" Grid.Row="0" Grid.Column="1" SelectionChanged="OnStructureTypeChanged" />

                                    <TextBlock Grid.Row="1" Grid.Column="0" Text="参数模板" />
                                    <Grid Grid.Row="1" Grid.Column="1">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" MinWidth="120" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <ComboBox x:Name="CmbPreset"
                                                  Grid.Column="0"
                                                  ToolTip="选择模板快速套用"
                                                  SelectionChanged="OnPresetSelectionChanged" />
                                        <Button x:Name="BtnSaveTemplate"
                                                Grid.Column="1"
                                                Content="存为模板"
                                                Margin="8,0,0,0"
                                                ToolTip="把当前参数存成模板"
                                                Click="OnSaveAsTemplateClick" />
                                        <Button x:Name="BtnManageTemplate"
                                                Grid.Column="2"
                                                Content="管理"
                                                Margin="8,0,0,0"
                                                ToolTip="重命名、删除、导入导出模板"
                                                Click="OnManageTemplatesClick" />
                                    </Grid>

                                    <!-- 存为模板时的名称/备注：就地展开，不弹窗 -->
                                    <Grid x:Name="GridTemplateSave"
                                          Grid.Row="2"
                                          Grid.Column="1"
                                          Visibility="Collapsed"
                                          Margin="0,4,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" MinWidth="110" />
                                            <ColumnDefinition Width="8" />
                                            <ColumnDefinition Width="*" MinWidth="110" />
                                            <ColumnDefinition Width="8" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBox x:Name="TxtTemplateName"
                                                 Grid.Column="0"
                                                 ToolTip="模板名称" />
                                        <TextBox x:Name="TxtTemplateNote"
                                                 Grid.Column="2"
                                                 ToolTip="备注（可留空）" />
                                        <Button Grid.Column="4"
                                                Content="保存"
                                                Margin="0,0,8,0"
                                                IsDefault="False"
                                                Click="OnConfirmSaveTemplateClick" />
                                        <Button Grid.Column="5"
                                                Content="取消"
                                                Click="OnCancelSaveTemplateClick" />
                                    </Grid>

                                    <TextBlock Grid.Row="3" Grid.Column="0" Text="构件位号" />
                                    <Grid Grid.Row="3" Grid.Column="1">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" MinWidth="120" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" MinWidth="100" />
                                        </Grid.ColumnDefinitions>
                                        <TextBox x:Name="TxtTag" Grid.Column="0" />
                                        <TextBlock Grid.Column="1" Text="材质" Margin="10,0,8,0" />
                                        <ComboBox x:Name="CmbMaterial" Grid.Column="2" SelectionChanged="OnAnyParameterChanged" />
                                    </Grid>
                                </Grid>
                            </GroupBox>

                            <GroupBox Header="几何参数">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" SharedSizeGroup="EditFormLabel" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <TextBlock x:Name="LblSpan" Grid.Row="0" Grid.Column="0" Text="跨度 B (mm)" />
                                    <TextBox x:Name="TxtSpan" Grid.Row="0" Grid.Column="1" TextChanged="OnAnyParameterChanged" />

                                    <TextBlock x:Name="LblLength" Grid.Row="1" Grid.Column="0" Text="宽度 L (mm)" />
                                    <TextBox x:Name="TxtLength" Grid.Row="1" Grid.Column="1" TextChanged="OnAnyParameterChanged" />

                                    <TextBlock x:Name="LblHeight" Grid.Row="2" Grid.Column="0" Text="高度 H (mm)" />
                                    <TextBox x:Name="TxtHeight" Grid.Row="2" Grid.Column="1" TextChanged="OnAnyParameterChanged" />

                                    <TextBlock x:Name="LblSubHeight" Grid.Row="3" Grid.Column="0" Text="次层高 h1 (mm)" />
                                    <TextBox x:Name="TxtSubHeight" Grid.Row="3" Grid.Column="1" TextChanged="OnAnyParameterChanged" />

                                    <TextBlock x:Name="LblBayCount" Grid.Row="4" Grid.Column="0" Text="跨数 / 层数" />
                                    <TextBox x:Name="TxtBayCount" Grid.Row="4" Grid.Column="1" TextChanged="OnAnyParameterChanged" />

                                    <TextBlock x:Name="LblAngleAndDz" Grid.Row="5" Grid.Column="0" Text="旋转角 (°)" VerticalAlignment="Center" />
                                    <Grid Grid.Row="5" Grid.Column="1">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" MinWidth="80" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" MinWidth="80" />
                                        </Grid.ColumnDefinitions>
                                        <TextBox x:Name="TxtRotationDeg" Grid.Column="0" TextChanged="OnAnyParameterChanged" />
                                        <TextBlock x:Name="LblEndDz" Grid.Column="1" Text="终点高差 (mm)" Margin="10,0,8,0" />
                                        <TextBox x:Name="TxtEndOffsetZ" Grid.Column="2" TextChanged="OnAnyParameterChanged" />
                                    </Grid>
                                </Grid>
                            </GroupBox>

                            <GroupBox Header="截面规格" Margin="0">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" SharedSizeGroup="EditFormLabel" />
                                        <ColumnDefinition Width="150" MinWidth="130" />
                                        <ColumnDefinition Width="8" />
                                        <ColumnDefinition Width="*" MinWidth="160" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <TextBlock x:Name="LblColSec" Grid.Row="0" Grid.Column="0" Text="立柱截面" VerticalAlignment="Center" />
                                    <controls:SectionTypePickerControl x:Name="ColTypePicker" Grid.Row="0" Grid.Column="1" Placeholder="全部类型" SelectionChanged="OnColTypeChanged" />
                                    <controls:SectionPickerControl x:Name="ColSpecPicker" Grid.Row="0" Grid.Column="3" Placeholder="选择规格" SelectionChanged="OnAnyParameterChanged" />

                                    <TextBlock x:Name="LblBeamSec" Grid.Row="1" Grid.Column="0" Text="主梁截面" VerticalAlignment="Center" />
                                    <controls:SectionTypePickerControl x:Name="BeamTypePicker" Grid.Row="1" Grid.Column="1" Placeholder="全部类型" SelectionChanged="OnBeamTypeChanged" />
                                    <controls:SectionPickerControl x:Name="BeamSpecPicker" Grid.Row="1" Grid.Column="3" Placeholder="选择规格" SelectionChanged="OnAnyParameterChanged" />

                                    <TextBlock x:Name="LblBraceSec" Grid.Row="2" Grid.Column="0" Text="斜撑截面" VerticalAlignment="Center" />
                                    <controls:SectionTypePickerControl x:Name="BraceTypePicker" Grid.Row="2" Grid.Column="1" Placeholder="全部类型" SelectionChanged="OnBraceTypeChanged" />
                                    <controls:SectionPickerControl x:Name="BraceSpecPicker" Grid.Row="2" Grid.Column="3" Placeholder="选择规格" SelectionChanged="OnAnyParameterChanged" />
                                </Grid>
                            </GroupBox>
                        </StackPanel>
                    </ScrollViewer>
            </Grid>
            </TabItem>

            <TabItem x:Name="TbiBom" Header="材料清单">
            <Grid x:Name="BomPanel">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <TextBlock x:Name="TxtLiveWeightSummary" Grid.Row="0" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,0,0,8" />
                    <DataGrid x:Name="DgPreviewBom" Grid.Row="1"
                              AutoGenerateColumns="False"
                              CanUserAddRows="False"
                              IsReadOnly="True"
                              RowHeaderWidth="0"
                              HorizontalScrollBarVisibility="Auto"
                              VerticalScrollBarVisibility="Auto">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="件号" Binding="{Binding PartNo, StringFormat=#{0}}" Width="56" MinWidth="50" ElementStyle="{StaticResource DataGridText.Cell}" EditingElementStyle="{StaticResource DataGridText.EditingCell}"/>
                            <DataGridTextColumn Header="构件部位" Binding="{Binding PartRole}" Width="1.15*" MinWidth="110" ElementStyle="{StaticResource DataGridText.Cell}" EditingElementStyle="{StaticResource DataGridText.EditingCell}"/>
                            <DataGridTextColumn Header="截面规格" Binding="{Binding SectionName}" Width="1.35*" MinWidth="130" ElementStyle="{StaticResource DataGridText.Cell}" EditingElementStyle="{StaticResource DataGridText.EditingCell}"/>
                            <DataGridTextColumn Header="数量" Binding="{Binding Count}" Width="56" MinWidth="50" ElementStyle="{StaticResource DataGridText.Cell}" EditingElementStyle="{StaticResource DataGridText.EditingCell}"/>
                            <DataGridTextColumn Header="单长(mm)" Binding="{Binding SingleLengthMm, StringFormat=0}" Width="84" MinWidth="75" ElementStyle="{StaticResource DataGridText.Cell}" EditingElementStyle="{StaticResource DataGridText.EditingCell}"/>
                            <DataGridTextColumn Header="小计重(kg)" Binding="{Binding TotalWeightKg, StringFormat=0.00}" Width="88" MinWidth="80" ElementStyle="{StaticResource DataGridText.Cell}" EditingElementStyle="{StaticResource DataGridText.EditingCell}"/>
                        </DataGrid.Columns>
                    </DataGrid>
            </Grid>
            </TabItem>
        </TabControl>

        <Grid Grid.Row="1" Margin="0,8,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MinWidth="120" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBlock x:Name="TxtHint"
                       Grid.Column="0"
                       Foreground="{x:Static SystemColors.GrayTextBrush}"
                       VerticalAlignment="Center"
                       TextTrimming="CharacterEllipsis"
                       ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" />

            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button x:Name="BtnUpdate" Content="更新模型" Margin="0,0,8,0" Click="OnSinglePointConfirmClick" />
                <Button x:Name="BtnSinglePt" Content="单点放置" Margin="0,0,8,0" Click="OnSinglePointConfirmClick" />
                <Button x:Name="BtnLinearTwoPt" Content="两点线性绘制" Margin="0,0,8,0" Click="OnLinearDrawConfirmClick" />
                <Button x:Name="BtnCancel" Content="取消" IsCancel="True" Click="OnCancelClick" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
