<Window x:Class="SteelStructureSuite.Views.StructureEditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:SteelStructureSuite.Views.Controls"
        xmlns:winforms="clr-namespace:System.Windows.Forms.Integration;assembly=WindowsFormsIntegration"
        Title="参数化钢结构"
        Width="1160"
        Height="700"
        MinWidth="900"
        MinHeight="520"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResize"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/SteelStructureSuite;component/Views/Styles/DefaultMetrics.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TabControl Grid.Row="0">
            <TabItem x:Name="TbiParams" Header="参数与示意">
            <Grid x:Name="ParamsPanel">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- 结构类型 + 参数模板：不属于参数本身，保留为窗口控件 -->
                    <Border Grid.Row="0" Style="{StaticResource Panel.ToolStrip}">
                        <!-- 两行布局：窄窗口下也不会把「管理」按钮挤出可视区 -->
                        <Grid Grid.IsSharedSizeScope="True">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" SharedSizeGroup="EditBarLabel" />
                                <ColumnDefinition Width="8" />
                                <ColumnDefinition Width="*" MinWidth="120" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <TextBlock x:Name="LblType" Grid.Row="0" Grid.Column="0" Text="结构类型" VerticalAlignment="Center" />
                            <ComboBox x:Name="CmbStructureType" Grid.Row="0" Grid.Column="2" Grid.ColumnSpan="3" SelectionChanged="OnStructureTypeChanged" />

                            <TextBlock Grid.Row="1" Grid.Column="0" Text="参数模板" VerticalAlignment="Center" Margin="0,6,0,0" />
                            <ComboBox x:Name="CmbPreset" Grid.Row="1" Grid.Column="2" Margin="0,6,0,0" ToolTip="选择模板快速套用" SelectionChanged="OnPresetSelectionChanged" />
                            <Button x:Name="BtnSaveTemplate" Grid.Row="1" Grid.Column="3" Content="存为模板" Margin="8,6,0,0" ToolTip="把当前参数存成模板" Click="OnSaveAsTemplateClick" />
                            <Button x:Name="BtnManageTemplate" Grid.Row="1" Grid.Column="4" Content="管理" Margin="8,6,0,0" ToolTip="重命名、删除、导入导出模板" Click="OnManageTemplatesClick" />
                        </Grid>
                    </Border>

                    <!-- 存为模板：名称/备注就地展开，不弹窗 -->
                    <Grid x:Name="GridTemplateSave" Grid.Row="1" Visibility="Collapsed" Margin="0,6,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" MinWidth="110" />
                            <ColumnDefinition Width="8" />
                            <ColumnDefinition Width="*" MinWidth="110" />
                            <ColumnDefinition Width="8" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="TxtTemplateName" Grid.Column="0" ToolTip="模板名称" />
                        <TextBox x:Name="TxtTemplateNote" Grid.Column="2" ToolTip="备注（可留空）" />
                        <Button Grid.Column="4" Content="保存" Margin="0,0,8,0" Click="OnConfirmSaveTemplateClick" />
                        <Button Grid.Column="5" Content="取消" Click="OnCancelSaveTemplateClick" />
                    </Grid>

                    <!-- 左图右参数：两列可调布局（左：三维轴测示意图；右：参数 PropertyGrid） -->
                    <Grid Grid.Row="2" Margin="0,8,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition x:Name="ColSchematic" Width="0.95*" MinWidth="300" />
                            <ColumnDefinition Width="8" />
                            <ColumnDefinition x:Name="ColParams" Width="1.25*" MinWidth="420" />
                        </Grid.ColumnDefinitions>

                        <controls:StructureSchematicControl x:Name="SchematicView" Grid.Column="0" />

                        <GridSplitter Grid.Column="1"
                                      Width="8"
                                      HorizontalAlignment="Stretch"
                                      VerticalAlignment="Stretch"
                                      Background="{x:Static SystemColors.ControlBrush}"
                                      BorderBrush="{x:Static SystemColors.ControlDarkBrush}"
                                      BorderThickness="1,0,1,0"
                                      ResizeBehavior="PreviousAndNext"
                                      Cursor="SizeWE"
                                      ToolTip="拖动调整轴测示意图与参数编辑区宽度" />

                        <Border Grid.Column="2"
                                BorderBrush="{x:Static SystemColors.ControlDarkBrush}"
                                BorderThickness="1"
                                SnapsToDevicePixels="True">
                            <winforms:WindowsFormsHost x:Name="ParamPropertyHost" />
                        </Border>
                    </Grid>

                    <!-- 旧参数控件（隐藏保留）：仅用于复用既有同步/校验/截面记忆逻辑，用户不可见 -->
                    <StackPanel x:Name="LegacyForm" Visibility="Collapsed">
                        <TextBox x:Name="TxtTag" />
                        <ComboBox x:Name="CmbMaterial" SelectionChanged="OnAnyParameterChanged" />
                        <TextBlock x:Name="LblSpan" Text="跨度 B (mm)" /><TextBox x:Name="TxtSpan" TextChanged="OnAnyParameterChanged" />
                        <TextBlock x:Name="LblLength" Text="宽度 L (mm)" /><TextBox x:Name="TxtLength" TextChanged="OnAnyParameterChanged" />
                        <TextBlock x:Name="LblHeight" Text="高度 H (mm)" /><TextBox x:Name="TxtHeight" TextChanged="OnAnyParameterChanged" />
                        <TextBlock x:Name="LblSubHeight" Text="次层高 h1 (mm)" /><TextBox x:Name="TxtSubHeight" TextChanged="OnAnyParameterChanged" />
                        <TextBlock x:Name="LblBayCount" Text="跨数 / 层数" /><TextBox x:Name="TxtBayCount" TextChanged="OnAnyParameterChanged" />
                        <TextBlock x:Name="LblAngleAndDz" Text="旋转角 (°)" /><TextBox x:Name="TxtRotationDeg" TextChanged="OnAnyParameterChanged" />
                        <TextBlock x:Name="LblEndDz" Text="终点高差 (mm)" /><TextBox x:Name="TxtEndOffsetZ" TextChanged="OnAnyParameterChanged" />
                        <TextBlock x:Name="LblColSec" Text="立柱截面" />
                        <controls:SectionTypePickerControl x:Name="ColTypePicker" SelectionChanged="OnColTypeChanged" />
                        <controls:SectionPickerControl x:Name="ColSpecPicker" SelectionChanged="OnAnyParameterChanged" />
                        <TextBlock x:Name="LblBeamSec" Text="主梁截面" />
                        <controls:SectionTypePickerControl x:Name="BeamTypePicker" SelectionChanged="OnBeamTypeChanged" />
                        <controls:SectionPickerControl x:Name="BeamSpecPicker" SelectionChanged="OnAnyParameterChanged" />
                        <TextBlock x:Name="LblBraceSec" Text="斜撑截面" />
                        <controls:SectionTypePickerControl x:Name="BraceTypePicker" SelectionChanged="OnBraceTypeChanged" />
                        <controls:SectionPickerControl x:Name="BraceSpecPicker" SelectionChanged="OnAnyParameterChanged" />
                    </StackPanel>
            </Grid>
            </TabItem>

            <TabItem x:Name="TbiBom" Header="材料清单">
            <Grid x:Name="BomPanel">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <TextBlock x:Name="TxtLiveWeightSummary" Grid.Row="0" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,0,0,8" />
                    <DataGrid x:Name="DgPreviewBom" Grid.Row="1"
                              AutoGenerateColumns="False"
                              CanUserAddRows="False"
                              IsReadOnly="True"
                              RowHeaderWidth="0"
                              HorizontalScrollBarVisibility="Auto"
                              VerticalScrollBarVisibility="Auto">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="件号" Binding="{Binding PartNo, StringFormat=#{0}}" Width="56" MinWidth="50" ElementStyle="{StaticResource DataGridText.Cell}" EditingElementStyle="{StaticResource DataGridText.EditingCell}"/>
                            <DataGridTextColumn Header="构件部位" Binding="{Binding PartRole}" Width="1.15*" MinWidth="110" ElementStyle="{StaticResource DataGridText.Cell}" EditingElementStyle="{StaticResource DataGridText.EditingCell}"/>
                            <DataGridTextColumn Header="截面规格" Binding="{Binding SectionName}" Width="1.35*" MinWidth="130" ElementStyle="{StaticResource DataGridText.Cell}" EditingElementStyle="{StaticResource DataGridText.EditingCell}"/>
                            <DataGridTextColumn Header="数量" Binding="{Binding Count}" Width="56" MinWidth="50" ElementStyle="{StaticResource DataGridText.Cell}" EditingElementStyle="{StaticResource DataGridText.EditingCell}"/>
                            <DataGridTextColumn Header="单长(mm)" Binding="{Binding SingleLengthMm, StringFormat=0}" Width="84" MinWidth="75" ElementStyle="{StaticResource DataGridText.Cell}" EditingElementStyle="{StaticResource DataGridText.EditingCell}"/>
                            <DataGridTextColumn Header="小计重(kg)" Binding="{Binding TotalWeightKg, StringFormat=0.00}" Width="88" MinWidth="80" ElementStyle="{StaticResource DataGridText.Cell}" EditingElementStyle="{StaticResource DataGridText.EditingCell}"/>
                        </DataGrid.Columns>
                    </DataGrid>
            </Grid>
            </TabItem>
        </TabControl>

        <Grid Grid.Row="1" Margin="0,8,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MinWidth="120" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBlock x:Name="TxtHint"
                       Grid.Column="0"
                       Foreground="{x:Static SystemColors.GrayTextBrush}"
                       VerticalAlignment="Center"
                       TextTrimming="CharacterEllipsis"
                       ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" />

            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button x:Name="BtnUpdate" Content="更新模型" Margin="0,0,8,0" Click="OnSinglePointConfirmClick" />
                <Button x:Name="BtnSinglePt" Content="单点放置" Margin="0,0,8,0" Click="OnSinglePointConfirmClick" />
                <Button x:Name="BtnLinearTwoPt" Content="两点线性绘制" Margin="0,0,8,0" Click="OnLinearDrawConfirmClick" />
                <Button x:Name="BtnCancel" Content="取消" IsCancel="True" Click="OnCancelClick" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
