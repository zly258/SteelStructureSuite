<Window x:Class="SteelStructureSuite.Views.StructureEditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:SteelStructureSuite.Views.Controls"
        Title="参数化钢结构"
        Width="590" Height="730"
        MinWidth="550" MinHeight="630"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResize"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TabControl Grid.Row="0">
            <!-- Tab 1: 参数与示意 -->
            <TabItem Header="参数与示意" Padding="14,5">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="6,4,6,4">
                        <controls:StructureSchematicControl x:Name="SchematicView" />

                        <GroupBox Header="基本属性与标准预设" Margin="0,0,0,8" Padding="10,6">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="136" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <TextBlock x:Name="LblType" Grid.Row="0" Grid.Column="0" Text="结构类型:" VerticalAlignment="Center" Margin="0,4,8,4" />
                                <ComboBox x:Name="CmbStructureType" Grid.Row="0" Grid.Column="1" MinHeight="27" VerticalContentAlignment="Center" Padding="6,3" Margin="0,3" SelectionChanged="OnStructureTypeChanged" />

                                <TextBlock Grid.Row="1" Grid.Column="0" Text="工程标准预设:" VerticalAlignment="Center" Margin="0,4,8,4" />
                                <ComboBox x:Name="CmbPreset" Grid.Row="1" Grid.Column="1" MinHeight="27" VerticalContentAlignment="Center" Padding="6,3" Margin="0,3" SelectionChanged="OnPresetSelectionChanged" />

                                <TextBlock Grid.Row="2" Grid.Column="0" Text="构件位号:" VerticalAlignment="Center" Margin="0,4,8,4" />
                                <Grid Grid.Row="2" Grid.Column="1">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="125" />
                                    </Grid.ColumnDefinitions>
                                    <TextBox x:Name="TxtTag" Grid.Column="0" MinHeight="27" VerticalContentAlignment="Center" Padding="6,3" Margin="0,3" />
                                    <TextBlock Grid.Column="1" Text="材质:" VerticalAlignment="Center" Margin="12,0,6,0" />
                                    <ComboBox x:Name="CmbMaterial" Grid.Column="2" MinHeight="27" VerticalContentAlignment="Center" Padding="6,3" Margin="0,3" SelectionChanged="OnAnyParameterChanged" />
                                </Grid>
                            </Grid>
                        </GroupBox>

                        <GroupBox Header="几何控制参数" Margin="0,0,0,8" Padding="10,6">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="136" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <TextBlock x:Name="LblSpan" Grid.Row="0" Grid.Column="0" Text="跨度 B (mm):" VerticalAlignment="Center" Margin="0,4,8,4" />
                                <TextBox x:Name="TxtSpan" Grid.Row="0" Grid.Column="1" MinHeight="27" VerticalContentAlignment="Center" Padding="6,3" Margin="0,3" TextChanged="OnAnyParameterChanged" />

                                <TextBlock x:Name="LblLength" Grid.Row="1" Grid.Column="0" Text="宽度 L (mm):" VerticalAlignment="Center" Margin="0,4,8,4" />
                                <TextBox x:Name="TxtLength" Grid.Row="1" Grid.Column="1" MinHeight="27" VerticalContentAlignment="Center" Padding="6,3" Margin="0,3" TextChanged="OnAnyParameterChanged" />

                                <TextBlock x:Name="LblHeight" Grid.Row="2" Grid.Column="0" Text="高度 H (mm):" VerticalAlignment="Center" Margin="0,4,8,4" />
                                <TextBox x:Name="TxtHeight" Grid.Row="2" Grid.Column="1" MinHeight="27" VerticalContentAlignment="Center" Padding="6,3" Margin="0,3" TextChanged="OnAnyParameterChanged" />

                                <TextBlock x:Name="LblSubHeight" Grid.Row="3" Grid.Column="0" Text="次层高 h1 (mm):" VerticalAlignment="Center" Margin="0,4,8,4" />
                                <TextBox x:Name="TxtSubHeight" Grid.Row="3" Grid.Column="1" MinHeight="27" VerticalContentAlignment="Center" Padding="6,3" Margin="0,3" TextChanged="OnAnyParameterChanged" />

                                <TextBlock x:Name="LblBayCount" Grid.Row="4" Grid.Column="0" Text="跨数 / 层数:" VerticalAlignment="Center" Margin="0,4,8,4" />
                                <TextBox x:Name="TxtBayCount" Grid.Row="4" Grid.Column="1" MinHeight="27" VerticalContentAlignment="Center" Padding="6,3" Margin="0,3" TextChanged="OnAnyParameterChanged" />

                                <TextBlock x:Name="LblAngleAndDz" Grid.Row="5" Grid.Column="0" Text="平面旋转角 (°):" VerticalAlignment="Center" Margin="0,4,8,4" />
                                <Grid Grid.Row="5" Grid.Column="1">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBox x:Name="TxtRotationDeg" Grid.Column="0" MinHeight="27" VerticalContentAlignment="Center" Padding="6,3" Margin="0,3" TextChanged="OnAnyParameterChanged" />
                                    <TextBlock x:Name="LblEndDz" Grid.Column="1" Text="终点高差 ΔZ (mm):" VerticalAlignment="Center" Margin="12,0,6,0" />
                                    <TextBox x:Name="TxtEndOffsetZ" Grid.Column="2" MinHeight="27" VerticalContentAlignment="Center" Padding="6,3" Margin="0,3" TextChanged="OnAnyParameterChanged" />
                                </Grid>
                            </Grid>
                        </GroupBox>

                        <GroupBox Header="截面规格选型 (支持按 5 类分表快速过滤)" Padding="10,6">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="116" />
                                    <ColumnDefinition Width="108" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <TextBlock x:Name="LblColSec" Grid.Row="0" Grid.Column="0" Text="立柱截面:" VerticalAlignment="Center" Margin="0,4,8,4" />
                                <ComboBox x:Name="CmbColTypeFilter" Grid.Row="0" Grid.Column="1" MinHeight="27" VerticalContentAlignment="Center" Padding="5,3" Margin="0,3,6,3" SelectionChanged="OnColFilterChanged" />
                                <ComboBox x:Name="CmbColSec" Grid.Row="0" Grid.Column="2" MinHeight="27" VerticalContentAlignment="Center" Padding="6,3" Margin="0,3" SelectionChanged="OnAnyParameterChanged" />

                                <TextBlock x:Name="LblBeamSec" Grid.Row="1" Grid.Column="0" Text="主梁截面:" VerticalAlignment="Center" Margin="0,4,8,4" />
                                <ComboBox x:Name="CmbBeamTypeFilter" Grid.Row="1" Grid.Column="1" MinHeight="27" VerticalContentAlignment="Center" Padding="5,3" Margin="0,3,6,3" SelectionChanged="OnBeamFilterChanged" />
                                <ComboBox x:Name="CmbBeamSec" Grid.Row="1" Grid.Column="2" MinHeight="27" VerticalContentAlignment="Center" Padding="6,3" Margin="0,3" SelectionChanged="OnAnyParameterChanged" />

                                <TextBlock x:Name="LblBraceSec" Grid.Row="2" Grid.Column="0" Text="斜撑截面:" VerticalAlignment="Center" Margin="0,4,8,4" />
                                <ComboBox x:Name="CmbBraceTypeFilter" Grid.Row="2" Grid.Column="1" MinHeight="27" VerticalContentAlignment="Center" Padding="5,3" Margin="0,3,6,3" SelectionChanged="OnBraceFilterChanged" />
                                <ComboBox x:Name="CmbBraceSec" Grid.Row="2" Grid.Column="2" MinHeight="27" VerticalContentAlignment="Center" Padding="6,3" Margin="0,3" SelectionChanged="OnAnyParameterChanged" />
                            </Grid>
                        </GroupBox>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- Tab 2: 材料清单 -->
            <TabItem x:Name="TabBom" Header="材料清单" Padding="14,5">
                <Grid Margin="6">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <TextBlock x:Name="TxtLiveWeightSummary" Grid.Row="0" FontWeight="Bold" Margin="2,4,2,8" TextWrapping="Wrap" />
                    <DataGrid x:Name="DgPreviewBom" Grid.Row="1"
                              AutoGenerateColumns="False"
                              CanUserAddRows="False"
                              IsReadOnly="True"
                              RowHeaderWidth="0"
                              HorizontalScrollBarVisibility="Auto"
                              VerticalScrollBarVisibility="Auto">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="件号" Binding="{Binding PartNo, StringFormat=#{0}}" Width="56" MinWidth="50" />
                            <DataGridTextColumn Header="构件部位" Binding="{Binding PartRole}" Width="1.15*" MinWidth="110" />
                            <DataGridTextColumn Header="截面规格" Binding="{Binding SectionName}" Width="1.35*" MinWidth="130" />
                            <DataGridTextColumn Header="数量" Binding="{Binding Count}" Width="56" MinWidth="50" />
                            <DataGridTextColumn Header="单长(mm)" Binding="{Binding SingleLengthMm, StringFormat=0}" Width="84" MinWidth="75" />
                            <DataGridTextColumn Header="小计重(kg)" Binding="{Binding TotalWeightKg, StringFormat=0.00}" Width="88" MinWidth="80" />
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>
        </TabControl>

        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
            <Button x:Name="BtnUpdate" Content="更新模型" MinWidth="110" MinHeight="30" Padding="14,5" Margin="6,2,0,2" Click="OnSinglePointConfirmClick" />
            <Button x:Name="BtnSinglePt" Content="单点放置" MinWidth="105" MinHeight="30" Padding="14,5" Margin="6,2,0,2" Click="OnSinglePointConfirmClick" />
            <Button x:Name="BtnLinearTwoPt" Content="两点线性绘制" MinWidth="125" MinHeight="30" Padding="14,5" Margin="6,2,0,2" Click="OnLinearDrawConfirmClick" />
            <Button x:Name="BtnCancel" Content="取消" MinWidth="80" MinHeight="30" Padding="14,5" Margin="6,2,0,2" IsCancel="True" Click="OnCancelClick" />
        </StackPanel>
    </Grid>
</Window>
