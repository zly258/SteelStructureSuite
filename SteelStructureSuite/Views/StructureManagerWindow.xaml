<Window x:Class="SteelStructureSuite.Views.StructureManagerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="钢结构模型管理器"
        Width="980"
        Height="600"
        MinWidth="820"
        MinHeight="420"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResize"
        FontSize="{DynamicResource FontSize.Body}"
        Background="{DynamicResource Brush.WindowBackground}"
        Foreground="{DynamicResource Brush.Text.Primary}"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display">
    <Window.FontFamily>
        <DynamicResource ResourceKey="Font.Ui" />
    </Window.FontFamily>
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/SteelStructureSuite;component/Theme/Theme.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>
    <Grid Margin="{StaticResource Layout.WindowPadding}">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MinWidth="190" />
                <ColumnDefinition Width="8" />
                <ColumnDefinition Width="2*" MinWidth="420" />
            </Grid.ColumnDefinitions>

            <GroupBox Grid.Column="0" Header="结构类型" Margin="0">
                <TreeView x:Name="TreeStructures" SelectedItemChanged="OnTreeSelectionChanged" />
            </GroupBox>

            <GridSplitter Grid.Column="1" Width="8" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Background="Transparent" />

            <GroupBox Grid.Column="2" Header="构件列表" Margin="0">
                <DataGrid x:Name="DgStructures"
                          AutoGenerateColumns="False"
                          CanUserAddRows="False"
                          IsReadOnly="True"
                          SelectionMode="Single"
                          RowHeaderWidth="0"
                          HorizontalScrollBarVisibility="Auto"
                          VerticalScrollBarVisibility="Auto"
                          MouseDoubleClick="OnLocateAndHighlightClick">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="位号" Binding="{Binding Tag}" Width="80" MinWidth="65" />
                        <DataGridTextColumn Header="构件类型" Binding="{Binding TypeName}" Width="1.2*" MinWidth="125" />
                        <DataGridTextColumn Header="控制尺寸(mm)" Binding="{Binding SizeSummary}" Width="1.15*" MinWidth="115" />
                        <DataGridTextColumn Header="主截面" Binding="{Binding MainSection}" Width="1.1*" MinWidth="110" />
                        <DataGridTextColumn Header="材质" Binding="{Binding Material}" Width="70" MinWidth="60" />
                        <DataGridTextColumn Header="重量(kg)" Binding="{Binding WeightKg, StringFormat=0.00}" Width="86" MinWidth="75" />
                        <DataGridTextColumn Header="坐标(X,Y,Z)" Binding="{Binding PositionStr}" Width="1.15*" MinWidth="120" />
                    </DataGrid.Columns>
                </DataGrid>
            </GroupBox>
        </Grid>

        <TextBlock x:Name="TxtStatus" Grid.Row="1" Style="{StaticResource Text.Caption}" TextWrapping="Wrap" Margin="0,0,0,8" />

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="定位高亮" MinWidth="{StaticResource Layout.ButtonMinWidth}" Style="{StaticResource Button.Primary}" Margin="0,0,8,0" Click="OnLocateAndHighlightClick" />
            <Button Content="编辑参数" MinWidth="{StaticResource Layout.ButtonMinWidth}" Margin="0,0,8,0" Click="OnEditSelectedClick" />
            <Button Content="施工详图" MinWidth="{StaticResource Layout.ButtonMinWidth}" Margin="0,0,8,0" Click="OnDrawSelectedClick" />
            <Button Content="删除构件" MinWidth="{StaticResource Layout.ButtonMinWidth}" Style="{StaticResource Button.Danger}" Margin="0,0,8,0" Click="OnDeleteSelectedClick" />
            <Button Content="刷新" MinWidth="{StaticResource Layout.ButtonMinWidth}" Margin="0,0,8,0" Click="OnRefreshClick" />
            <Button Content="关闭" MinWidth="{StaticResource Layout.ButtonMinWidth}" IsCancel="True" Click="OnCloseClick" />
        </StackPanel>
    </Grid>
</Window>
