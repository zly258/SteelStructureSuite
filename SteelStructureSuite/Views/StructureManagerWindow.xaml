<Window x:Class="SteelStructureSuite.Views.StructureManagerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="钢结构模型管理器"
        Width="960" Height="560"
        MinWidth="820" MinHeight="460"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResize"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="245" MinWidth="190" />
                <ColumnDefinition Width="8" />
                <ColumnDefinition Width="*" MinWidth="460" />
            </Grid.ColumnDefinitions>

            <GroupBox Grid.Column="0" Header="结构类型树" Padding="6">
                <TreeView x:Name="TreeStructures" SelectedItemChanged="OnTreeSelectionChanged" />
            </GroupBox>

            <GridSplitter Grid.Column="1" Width="6" HorizontalAlignment="Center" VerticalAlignment="Stretch" Background="Transparent" ShowsPreview="True" />

            <GroupBox Grid.Column="2" Header="构件列表 (双击行自动定位并高亮)" Padding="6">
                <DataGrid x:Name="DgStructures"
                          AutoGenerateColumns="False"
                          CanUserAddRows="False"
                          IsReadOnly="True"
                          SelectionMode="Single"
                          RowHeaderWidth="0"
                          HorizontalScrollBarVisibility="Auto"
                          VerticalScrollBarVisibility="Auto"
                          MouseDoubleClick="OnLocateAndHighlightClick">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="位号" Binding="{Binding Tag}" Width="80" MinWidth="65" />
                        <DataGridTextColumn Header="构件类型" Binding="{Binding TypeName}" Width="1.2*" MinWidth="125" />
                        <DataGridTextColumn Header="控制尺寸(mm)" Binding="{Binding SizeSummary}" Width="1.15*" MinWidth="115" />
                        <DataGridTextColumn Header="主截面" Binding="{Binding MainSection}" Width="1.1*" MinWidth="110" />
                        <DataGridTextColumn Header="材质" Binding="{Binding Material}" Width="70" MinWidth="60" />
                        <DataGridTextColumn Header="重量(kg)" Binding="{Binding WeightKg, StringFormat=0.00}" Width="86" MinWidth="75" />
                        <DataGridTextColumn Header="坐标(X,Y,Z)" Binding="{Binding PositionStr}" Width="1.15*" MinWidth="120" />
                    </DataGrid.Columns>
                </DataGrid>
            </GroupBox>
        </Grid>

        <DockPanel Grid.Row="1" Margin="0,8,0,0">
            <WrapPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Button Content="定位高亮" MinWidth="88" MinHeight="29" Padding="10,4" Margin="6,2,0,2" Click="OnLocateAndHighlightClick" />
                <Button Content="编辑参数" MinWidth="88" MinHeight="29" Padding="10,4" Margin="6,2,0,2" Click="OnEditSelectedClick" />
                <Button Content="施工详图" MinWidth="88" MinHeight="29" Padding="10,4" Margin="6,2,0,2" Click="OnDrawSelectedClick" />
                <Button Content="删除构件" MinWidth="88" MinHeight="29" Padding="10,4" Margin="6,2,0,2" Click="OnDeleteSelectedClick" />
                <Button Content="刷新" MinWidth="72" MinHeight="29" Padding="10,4" Margin="6,2,0,2" Click="OnRefreshClick" />
                <Button Content="关闭" MinWidth="72" MinHeight="29" Padding="10,4" Margin="6,2,0,2" IsCancel="True" Click="OnCloseClick" />
            </WrapPanel>
            <TextBlock x:Name="TxtStatus" VerticalAlignment="Center" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" Margin="0,0,8,0" />
        </DockPanel>
    </Grid>
</Window>
