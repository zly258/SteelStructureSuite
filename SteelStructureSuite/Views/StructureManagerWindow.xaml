<Window x:Class="SteelStructureSuite.Views.StructureManagerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="钢结构模型管理器"
        Width="840" Height="520"
        MinWidth="720" MinHeight="440"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResize"
        UseLayoutRounding="True">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="220" />
                <ColumnDefinition Width="10" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <GroupBox Grid.Column="0" Header="结构类型树" Padding="6">
                <TreeView x:Name="TreeStructures" SelectedItemChanged="OnTreeSelectionChanged" />
            </GroupBox>

            <GroupBox Grid.Column="2" Header="构件列表 (双击行定位高亮)" Padding="6">
                <DataGrid x:Name="DgStructures"
                          AutoGenerateColumns="False"
                          CanUserAddRows="False"
                          IsReadOnly="True"
                          SelectionMode="Single"
                          RowHeaderWidth="0"
                          MouseDoubleClick="OnLocateAndHighlightClick">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="位号" Binding="{Binding Tag}" Width="75" />
                        <DataGridTextColumn Header="构件类型" Binding="{Binding TypeName}" Width="1.15*" />
                        <DataGridTextColumn Header="控制尺寸(mm)" Binding="{Binding SizeSummary}" Width="1.1*" />
                        <DataGridTextColumn Header="主截面" Binding="{Binding MainSection}" Width="1.1*" />
                        <DataGridTextColumn Header="材质" Binding="{Binding Material}" Width="65" />
                        <DataGridTextColumn Header="重量(kg)" Binding="{Binding WeightKg, StringFormat=0.00}" Width="80" />
                        <DataGridTextColumn Header="坐标(X,Y,Z)" Binding="{Binding PositionStr}" Width="1.1*" />
                    </DataGrid.Columns>
                </DataGrid>
            </GroupBox>
        </Grid>

        <DockPanel Grid.Row="1" Margin="0,8,0,0">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Button Content="定位高亮" MinWidth="85" Padding="10,4" Margin="6,2,0,2" Click="OnLocateAndHighlightClick" />
                <Button Content="编辑参数" MinWidth="85" Padding="10,4" Margin="6,2,0,2" Click="OnEditSelectedClick" />
                <Button Content="施工详图" MinWidth="85" Padding="10,4" Margin="6,2,0,2" Click="OnDrawSelectedClick" />
                <Button Content="删除构件" MinWidth="85" Padding="10,4" Margin="6,2,0,2" Click="OnDeleteSelectedClick" />
                <Button Content="刷新" MinWidth="68" Padding="10,4" Margin="6,2,0,2" Click="OnRefreshClick" />
                <Button Content="关闭" MinWidth="68" Padding="10,4" Margin="6,2,0,2" IsCancel="True" Click="OnCloseClick" />
            </StackPanel>
            <TextBlock x:Name="TxtStatus" VerticalAlignment="Center" FontWeight="SemiBold" />
        </DockPanel>
    </Grid>
</Window>
