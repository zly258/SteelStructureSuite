<Window x:Class="SteelStructureSuite.Views.StructureRenumberWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="构件位号顺号重排"
        Width="1040"
        Height="640"
        MinWidth="860"
        MinHeight="460"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResize"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/SteelStructureSuite;component/Views/Styles/DefaultMetrics.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <!-- layout-check: allow-fixed-window-height（顺号对比预览表格需要固定视口，数据区独立滚动） -->
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 顶部顺号与前缀统一规则设置 -->
        <GroupBox Grid.Row="0" Header="前缀统一与顺号规则设置" Margin="0,0,0,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.35*" MinWidth="150" />
                    <ColumnDefinition Width="8" />
                    <ColumnDefinition Width="0.95*" MinWidth="115" />
                    <ColumnDefinition Width="8" />
                    <ColumnDefinition Width="0.65*" MinWidth="72" />
                    <ColumnDefinition Width="8" />
                    <ColumnDefinition Width="0.85*" MinWidth="95" />
                    <ColumnDefinition Width="8" />
                    <ColumnDefinition Width="1.1*" MinWidth="125" />
                    <ColumnDefinition Width="8" />
                    <ColumnDefinition Width="1.1*" MinWidth="125" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock Text="处理策略" />
                    <ComboBox x:Name="CmbActionMode" SelectionChanged="OnRuleOptionChanged">
                        <ComboBoxItem Content="强制统一前缀并顺号" Tag="ForcePrefixAndRenumber" IsSelected="True" />
                        <ComboBoxItem Content="仅强制统一前缀(保原号)" Tag="ForcePrefixOnly" />
                        <ComboBoxItem Content="仅顺号(保留原前缀)" Tag="RenumberKeepPrefix" />
                    </ComboBox>
                </StackPanel>

                <StackPanel Grid.Column="2">
                    <TextBlock Text="编号位数" />
                    <ComboBox x:Name="CmbDigits" SelectionChanged="OnRuleOptionChanged">
                        <ComboBoxItem Content="2 位 (01)" Tag="2" />
                        <ComboBoxItem Content="3 位 (001)" Tag="3" IsSelected="True" />
                        <ComboBoxItem Content="4 位 (0001)" Tag="4" />
                        <ComboBoxItem Content="5 位 (00001)" Tag="5" />
                    </ComboBox>
                </StackPanel>

                <StackPanel Grid.Column="4">
                    <TextBlock Text="起始号" />
                    <TextBox x:Name="TxtStartNumber" Text="1" ToolTip="顺号起始数字，默认为 1" TextChanged="OnRuleTextChanged" />
                </StackPanel>

                <StackPanel Grid.Column="6">
                    <TextBlock Text="连接符" />
                    <ComboBox x:Name="CmbSeparator" SelectionChanged="OnRuleOptionChanged">
                        <ComboBoxItem Content="- (PF-001)" Tag="-" IsSelected="True" />
                        <ComboBoxItem Content="_ (PF_001)" Tag="_" />
                        <ComboBoxItem Content="无 (PF001)" Tag="" />
                    </ComboBox>
                </StackPanel>

                <StackPanel Grid.Column="8">
                    <TextBlock Text="编号范围" />
                    <ComboBox x:Name="CmbNumberingMode" SelectionChanged="OnRuleOptionChanged">
                        <ComboBoxItem Content="按类型分别顺号" Tag="ByType" IsSelected="True" />
                        <ComboBoxItem Content="全图统一顺号" Tag="Global" />
                    </ComboBox>
                </StackPanel>

                <StackPanel Grid.Column="10">
                    <TextBlock Text="同组排序" />
                    <ComboBox x:Name="CmbSortOrder" SelectionChanged="OnRuleOptionChanged">
                        <ComboBoxItem Content="坐标 X → Y → Z" Tag="XYZ" IsSelected="True" />
                        <ComboBoxItem Content="坐标 Y → X → Z" Tag="YXZ" />
                        <ComboBoxItem Content="按原位号顺序" Tag="OldTag" />
                    </ComboBox>
                </StackPanel>
            </Grid>
        </GroupBox>

        <!-- 中部：左侧各类型前缀配置 + 右侧顺号前后对比预览表格 -->
        <Grid Grid.Row="1" Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="290" MinWidth="220" MaxWidth="420" />
                <ColumnDefinition Width="8" />
                <ColumnDefinition Width="*" MinWidth="480" />
            </Grid.ColumnDefinitions>

            <!-- 左侧：按类型自定义前缀 -->
            <GroupBox Grid.Column="0" Header="按类型设置前缀（双击前缀可编辑）">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <CheckBox x:Name="ChkOnlyExistingTypes"
                              Grid.Row="0"
                              Content="仅显示当前图已有类型"
                              IsChecked="True"
                              Margin="0,0,0,6"
                              ToolTip="取消勾选可预设全部 26 种构件类型的默认编号前缀"
                              Checked="OnPrefixFilterChanged"
                              Unchecked="OnPrefixFilterChanged" />
                    <DataGrid x:Name="DgPrefixes"
                              Grid.Row="1"
                              AutoGenerateColumns="False"
                              CanUserAddRows="False"
                              IsReadOnly="False"
                              SelectionMode="Single"
                              RowHeaderWidth="0"
                              HorizontalScrollBarVisibility="Auto"
                              VerticalScrollBarVisibility="Auto"
                              CellEditEnding="OnPrefixCellEditEnding">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="构件类型" Binding="{Binding TypeName}" IsReadOnly="True" Width="1.45*" MinWidth="120" ElementStyle="{StaticResource DataGridText.Cell}" EditingElementStyle="{StaticResource DataGridText.EditingCell}"/>
                            <DataGridTextColumn Header="数量" Binding="{Binding Count}" IsReadOnly="True" Width="48" MinWidth="44" ElementStyle="{StaticResource DataGridText.Cell}" EditingElementStyle="{StaticResource DataGridText.EditingCell}"/>
                            <DataGridTextColumn Header="前缀" Binding="{Binding Prefix, UpdateSourceTrigger=PropertyChanged}" IsReadOnly="False" Width="0.75*" MinWidth="64" ElementStyle="{StaticResource DataGridText.Cell}" EditingElementStyle="{StaticResource DataGridText.EditingCell}"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </GroupBox>

            <GridSplitter Grid.Column="1"
                          Width="8"
                          HorizontalAlignment="Stretch"
                          VerticalAlignment="Stretch"
                          Background="{x:Static SystemColors.ControlBrush}"
                          BorderBrush="{x:Static SystemColors.ControlDarkBrush}"
                          BorderThickness="1,0,0,0"
                          ShowsPreview="True"
                          ResizeBehavior="PreviousAndNext" />

            <!-- 右侧：顺号前后对比预览 -->
            <GroupBox Grid.Column="2" Header="顺号前后对比预览">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Style="{StaticResource Panel.ToolStrip}" Margin="0,0,0,6">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Orientation="Horizontal">
                                <Button Content="全选" Margin="0,0,6,0" Click="OnSelectAllClick" />
                                <Button Content="仅选有变化" Margin="0,0,6,0" Click="OnSelectChangedOnlyClick" />
                                <Button Content="仅选前缀不符" ToolTip="只勾选当前位号前缀与配置前缀不一致的构件" Margin="0,0,6,0" Click="OnSelectPrefixMismatchClick" />
                                <Button Content="取消全选" Click="OnSelectNoneClick" />
                            </StackPanel>
                            <Border Grid.Column="2" Style="{StaticResource Panel.Badge}">
                                <TextBlock x:Name="TxtPreviewSummary"
                                           Text="共 0 项，待更新 0 项" />
                            </Border>
                        </Grid>
                    </Border>

                    <DataGrid x:Name="DgPreview"
                              Grid.Row="1"
                              AutoGenerateColumns="False"
                              CanUserAddRows="False"
                              IsReadOnly="False"
                              SelectionMode="Single"
                              RowHeaderWidth="0"
                              HorizontalScrollBarVisibility="Auto"
                              VerticalScrollBarVisibility="Auto">
                        <DataGrid.Columns>
                            <DataGridCheckBoxColumn Header="应用" Binding="{Binding IsSelected, UpdateSourceTrigger=PropertyChanged}" Width="52" MinWidth="48" ElementStyle="{StaticResource DataGridCheck.Cell}" EditingElementStyle="{StaticResource DataGridCheck.Cell}"/>
                            <DataGridTextColumn Header="构件类型" Binding="{Binding TypeName}" IsReadOnly="True" Width="1.15*" MinWidth="115" ElementStyle="{StaticResource DataGridText.Cell}" EditingElementStyle="{StaticResource DataGridText.EditingCell}"/>
                            <DataGridTextColumn Header="原位号" Binding="{Binding OldTag}" IsReadOnly="True" Width="0.9*" MinWidth="82" ElementStyle="{StaticResource DataGridText.Cell}" EditingElementStyle="{StaticResource DataGridText.EditingCell}"/>
                            <DataGridTextColumn Header="新位号" Binding="{Binding NewTag}" IsReadOnly="True" Width="0.95*" MinWidth="86" ElementStyle="{StaticResource DataGridText.Cell}" EditingElementStyle="{StaticResource DataGridText.EditingCell}"/>
                            <DataGridTextColumn Header="状态" Binding="{Binding StatusText}" IsReadOnly="True" Width="105" MinWidth="92" ElementStyle="{StaticResource DataGridText.Cell}" EditingElementStyle="{StaticResource DataGridText.EditingCell}"/>
                            <DataGridTextColumn Header="主截面" Binding="{Binding MainSection}" IsReadOnly="True" Width="1.0*" MinWidth="95" ElementStyle="{StaticResource DataGridText.Cell}" EditingElementStyle="{StaticResource DataGridText.EditingCell}"/>
                            <DataGridTextColumn Header="坐标(X,Y,Z)" Binding="{Binding PositionStr}" IsReadOnly="True" Width="1.1*" MinWidth="110" ElementStyle="{StaticResource DataGridText.Cell}" EditingElementStyle="{StaticResource DataGridText.EditingCell}"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </GroupBox>
        </Grid>

        <TextBlock x:Name="TxtTip"
                   Grid.Row="2"
                   Text="仅更新已勾选且位号发生变化的构件，不会改动构件三维几何尺寸与位置。"
                   Margin="0,0,0,8" />

        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="恢复默认前缀" Margin="0,0,8,0" Click="OnResetPrefixesClick" />
            <Button Content="保存前缀预设" ToolTip="仅保存各类型前缀、位数与连接符设置（新建构件时也将自动采用）" Margin="0,0,8,0" Click="OnSavePresetsOnlyClick" />
            <Button Content="应用顺号" IsDefault="True" Margin="0,0,8,0" Click="OnApplyClick" />
            <Button Content="取消" IsCancel="True" Click="OnCancelClick" />
        </StackPanel>
    </Grid>
</Window>
