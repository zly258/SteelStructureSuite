<Window x:Class="SteelStructureSuite.Views.TemplateManagerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="参数模板管理"
        Width="900"
        Height="600"
        MinWidth="760"
        MinHeight="460"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResize"
        ShowInTaskbar="False"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/SteelStructureSuite;component/Views/Styles/DefaultMetrics.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 顶部工具条 -->
        <Border Grid.Row="0" Style="{StaticResource Panel.ToolStrip}" Margin="0,0,0,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="8" />
                    <ColumnDefinition Width="*" MinWidth="140" />
                    <ColumnDefinition Width="8" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="筛选" VerticalAlignment="Center" />
                <TextBox x:Name="TxtFilter"
                         Grid.Column="2"
                         ToolTip="按模板名称、备注或构件类型筛选"
                         TextChanged="OnFilterChanged" />
                <Button Grid.Column="4" Content="清除" Click="OnClearFilterClick" />
                <Border Grid.Column="6" Style="{StaticResource Panel.Badge}">
                    <TextBlock x:Name="TxtCount" Text="0 个模板" />
                </Border>
            </Grid>
        </Border>

        <!-- 模板列表 + 详情 -->
        <Grid Grid.Row="1" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MinWidth="380" />
                <ColumnDefinition Width="8" />
                <ColumnDefinition Width="300" MinWidth="240" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource Panel.Card}" Padding="0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Border Grid.Row="0" Style="{StaticResource Panel.Header}">
                        <TextBlock Text="模板列表" FontWeight="SemiBold" />
                    </Border>
                    <DataGrid x:Name="DgTemplates"
                              Grid.Row="1"
                              AutoGenerateColumns="False"
                              CanUserAddRows="False"
                              IsReadOnly="True"
                              SelectionMode="Single"
                              RowHeaderWidth="0"
                              HorizontalScrollBarVisibility="Auto"
                              VerticalScrollBarVisibility="Auto"
                              SelectionChanged="OnTemplateSelectionChanged">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="模板名称" Binding="{Binding Name}" Width="1.4*" MinWidth="120" ElementStyle="{StaticResource DataGridText.Cell}" EditingElementStyle="{StaticResource DataGridText.EditingCell}"/>
                            <DataGridTextColumn Header="构件类型" Binding="{Binding TypeDisplay}" Width="1.2*" MinWidth="110" ElementStyle="{StaticResource DataGridText.Cell}" EditingElementStyle="{StaticResource DataGridText.EditingCell}"/>
                            <DataGridTextColumn Header="跨度" Binding="{Binding SpanText}" Width="0.7*" MinWidth="66" ElementStyle="{StaticResource DataGridText.Cell}" EditingElementStyle="{StaticResource DataGridText.EditingCell}"/>
                            <DataGridTextColumn Header="高度" Binding="{Binding HeightText}" Width="0.7*" MinWidth="66" ElementStyle="{StaticResource DataGridText.Cell}" EditingElementStyle="{StaticResource DataGridText.EditingCell}"/>
                            <DataGridTextColumn Header="主截面" Binding="{Binding ColumnSection}" Width="1.3*" MinWidth="110" ElementStyle="{StaticResource DataGridText.Cell}" EditingElementStyle="{StaticResource DataGridText.EditingCell}"/>
                            <DataGridTextColumn Header="备注" Binding="{Binding Note}" Width="1.2*" MinWidth="100" ElementStyle="{StaticResource DataGridText.Cell}" EditingElementStyle="{StaticResource DataGridText.EditingCell}"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>

            <Border Grid.Column="2" Style="{StaticResource Panel.Card}" Padding="0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Border Grid.Row="0" Style="{StaticResource Panel.Header}">
                        <TextBlock Text="模板详情" FontWeight="SemiBold" />
                    </Border>
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel Margin="10">
                            <TextBlock Text="名称" Style="{StaticResource Text.GroupHeader}" />
                            <TextBox x:Name="TxtName" Margin="12,0,0,8" />

                            <TextBlock Text="备注" Style="{StaticResource Text.GroupHeader}" />
                            <TextBox x:Name="TxtNote" Margin="12,0,0,8" />

                            <TextBlock Text="参数快照" Style="{StaticResource Text.GroupHeader}" />
                            <TextBox x:Name="TxtDetail"
                                     Margin="12,0,0,0"
                                     Height="180"
                                     MaxHeight="240"
                                     AcceptsReturn="True"
                                     TextWrapping="Wrap"
                                     IsReadOnly="True"
                                     VerticalScrollBarVisibility="Auto" />
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>

        <!-- 存储位置 -->
        <Border Grid.Row="2" Style="{StaticResource Panel.InfoBar}" Margin="0,0,0,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="8" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="TxtStorage"
                           Grid.Column="0"
                           TextTrimming="CharacterEllipsis"
                           ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" />
                <Button Grid.Column="2" Content="打开目录" Click="OnOpenFolderClick" />
            </Grid>
        </Border>

        <!-- 底部操作栏 -->
        <Grid Grid.Row="3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" Orientation="Horizontal">
                <Button Content="重命名" Margin="0,0,8,0" Click="OnRenameClick" />
                <Button Content="删除" Margin="0,0,8,0" Click="OnDeleteClick" />
                <Button Content="导入" Margin="0,0,8,0" Click="OnImportClick" />
                <Button Content="导出" Click="OnExportClick" />
            </StackPanel>
            <Button Grid.Column="2" Content="保存并关闭" IsDefault="True" Click="OnSaveCloseClick" />
        </Grid>
    </Grid>
</Window>
