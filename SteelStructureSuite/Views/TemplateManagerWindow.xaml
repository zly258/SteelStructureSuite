<Window x:Class="SteelStructureSuite.Views.TemplateManagerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="参数模板管理"
        Width="880"
        Height="580"
        MinWidth="720"
        MinHeight="440"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResize"
        ShowInTaskbar="False"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/SteelStructureSuite;component/Views/Styles/DefaultMetrics.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 顶部工具条：筛选 + 计数 -->
        <Border Grid.Row="0" Style="{StaticResource Panel.ToolStrip}" Margin="0,0,0,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="8" />
                    <ColumnDefinition Width="*" MinWidth="160" />
                    <ColumnDefinition Width="8" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="筛选" VerticalAlignment="Center" />
                <TextBox x:Name="TxtFilter"
                         Grid.Column="2"
                         ToolTip="按名称、备注、类型或截面筛选"
                         TextChanged="OnFilterChanged" />
                <Button Grid.Column="4" Content="清除" Click="OnClearFilterClick" />
                <Border Grid.Column="6" Style="{StaticResource Panel.Badge}">
                    <TextBlock x:Name="TxtCount" Text="0 个模板" />
                </Border>
            </Grid>
        </Border>

        <!-- 主区：模板表格（名称/备注可直接双击编辑） -->
        <Border Grid.Row="1" Style="{StaticResource Panel.Card}" Padding="0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Border Grid.Row="0" Style="{StaticResource Panel.Header}">
                    <TextBlock Text="模板列表" FontWeight="SemiBold" />
                </Border>
                <DataGrid x:Name="DgTemplates"
                          Grid.Row="1"
                          AutoGenerateColumns="False"
                          CanUserAddRows="False"
                          CanUserDeleteRows="False"
                          SelectionMode="Single"
                          RowHeaderWidth="0"
                          HorizontalScrollBarVisibility="Auto"
                          VerticalScrollBarVisibility="Auto"
                          SelectionChanged="OnTemplateSelectionChanged"
                          CellEditEnding="OnCellEditEnding">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="名称"
                                            Binding="{Binding Name, UpdateSourceTrigger=LostFocus}"
                                            Width="1.5*" MinWidth="130"
                                            ElementStyle="{StaticResource DataGridText.Cell}"
                                            EditingElementStyle="{StaticResource DataGridText.EditingCell}"/>
                        <DataGridTextColumn Header="构件类型"
                                            Binding="{Binding TypeDisplay}"
                                            Width="1.2*" MinWidth="110"
                                            IsReadOnly="True"
                                            ElementStyle="{StaticResource DataGridText.Cell}"
                                            EditingElementStyle="{StaticResource DataGridText.EditingCell}"/>
                        <DataGridTextColumn Header="跨度"
                                            Binding="{Binding SpanText}"
                                            Width="0.6*" MinWidth="60"
                                            IsReadOnly="True"
                                            ElementStyle="{StaticResource DataGridText.Cell}"
                                            EditingElementStyle="{StaticResource DataGridText.EditingCell}"/>
                        <DataGridTextColumn Header="高度"
                                            Binding="{Binding HeightText}"
                                            Width="0.6*" MinWidth="60"
                                            IsReadOnly="True"
                                            ElementStyle="{StaticResource DataGridText.Cell}"
                                            EditingElementStyle="{StaticResource DataGridText.EditingCell}"/>
                        <DataGridTextColumn Header="主截面"
                                            Binding="{Binding ColumnSection}"
                                            Width="1.3*" MinWidth="110"
                                            IsReadOnly="True"
                                            ElementStyle="{StaticResource DataGridText.Cell}"
                                            EditingElementStyle="{StaticResource DataGridText.EditingCell}"/>
                        <DataGridTextColumn Header="备注"
                                            Binding="{Binding Note, UpdateSourceTrigger=LostFocus}"
                                            Width="1.4*" MinWidth="120"
                                            ElementStyle="{StaticResource DataGridText.Cell}"
                                            EditingElementStyle="{StaticResource DataGridText.EditingCell}"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Border>

        <!-- 底部：操作栏（左：动作；右：状态 + 关闭） -->
        <Grid Grid.Row="2" Margin="0,10,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" MinWidth="80" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Orientation="Horizontal">
                <Button Content="删除" Margin="0,0,8,0" Click="OnDeleteClick" />
                <Button Content="导入" Margin="0,0,8,0" Click="OnImportClick" />
                <Button Content="导出" Click="OnExportClick" />
            </StackPanel>

            <TextBlock x:Name="TxtStatus"
                       Grid.Column="1"
                       Margin="12,0"
                       Foreground="{x:Static SystemColors.GrayTextBrush}"
                       VerticalAlignment="Center"
                       TextTrimming="CharacterEllipsis"
                       ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" />

            <Button Grid.Column="2" Content="关闭" MinWidth="88" IsDefault="True" IsCancel="True" Click="OnCloseClick" />
        </Grid>
    </Grid>
</Window>
